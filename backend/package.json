{
  "name": "bloomly-backend",
  "version": "1.5.55",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "build": "npx tsc -p tsconfig.json",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "node --loader ts-node/esm seed.ts",
    "db:backfill-tag-affinity": "node --loader ts-node/esm src/scripts/backfillTagAffinity.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.0",
    "minio": "^8.0.5",
    "node-cron": "^4.2.1",
    "pino-pretty": "^13.1.3",
    "resend": "^4.8.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.32.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
