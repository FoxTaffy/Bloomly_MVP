{
  "name": "bloomly-backend",
  "version": "1.5.161",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js",
    "build": "npx tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "node --loader ts-node/esm seed.ts",
    "db:backfill-tag-affinity": "node --loader ts-node/esm src/scripts/backfillTagAffinity.ts",
    "db:cleanup-orphaned-media": "node --loader ts-node/esm src/scripts/cleanupOrphanedMedia.ts",
    "db:cleanup-deleted-media": "node --loader ts-node/esm src/scripts/cleanupDeletedMedia.ts",
    "db:migrate-legacy-private-media": "node --loader ts-node/esm src/scripts/migrateLegacyPrivateMedia.ts",
    "db:release-unverified-accounts": "node --loader ts-node/esm src/scripts/releaseUnverifiedAccounts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/websocket": "11.3.4",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "5.12.7",
    "imapflow": "2.5.2",
    "mailparser": "3.9.40",
    "node-cron": "^4.2.1",
    "nodemailer": "10.1.2",
    "otplib": "^12.0.1",
    "pino": "10.4.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "resend": "^4.8.0",
    "sharp": "0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.5",
    "@types/node": "24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
