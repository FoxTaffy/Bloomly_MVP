generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                    @id @default(uuid()) @db.Uuid
  email                          String                    @unique
  username                       String                    @unique
  password                       String?
  email_verified                 Boolean                   @default(false)
  onboarding_done                Boolean                   @default(false)
  display_name                   String?                   @db.VarChar(50)
  created_at                     DateTime                  @default(now())
  updated_at                     DateTime                  @updatedAt
  deleted_at                     DateTime?
  role                           String                    @default("user")
  bio                            String?                   @db.VarChar(300)
  avatar_url                     String?
  avatar_video_url               String?
  banner_url                     String?
  status                         String?                   @db.VarChar(100)
  profile_status                 Json?
  persona                        String?
  likes                          String[]
  dislikes                       String[]
  accent_color                   String?
  website                        String?
  location                       String?
  pronouns                       String?
  badge_type                     String?
  prev_badge_type                String?
  job_title                      String?                   @db.VarChar(80)
  pinned_post_id                 String?                   @db.Uuid
  relationship_status            String?                   @db.VarChar(50)
  country                        String?                   @db.VarChar(80)
  fursona_name                   String?                   @db.VarChar(80)
  relationship_with              String?                   @db.Uuid
  birth_date                     DateTime?                 @db.Timestamp(6)
  birth_date_visibility          String                    @default("hidden") @db.VarChar(20)
  fursona_color                  String?                   @db.VarChar(50)
  fursona_gender                 String?                   @db.VarChar(50)
  fursona_description            String?
  relationship_since             DateTime?                 @db.Timestamp(6)
  fursona_photo_url              String?
  has_fursuit                    Boolean                   @default(false)
  fursuit_photo_url              String?
  fursuit_description            String?
  fursuit_maker                  String?                   @db.VarChar(200)
  social_links                   Json?                     @default("{}")
  interests                      String[]                  @default([])
  fav_food                       String?                   @db.VarChar(80)
  fav_animal                     String?                   @db.VarChar(80)
  fav_music                      String?                   @db.VarChar(80)
  fav_artist                     String?                   @db.VarChar(80)
  fav_film                       String?                   @db.VarChar(80)
  public_key                     String?
  subscription_tier              String                    @default("free") @db.VarChar(20)
  // Конец оплаченного периода. null у платного тарифа — выдан админом бессрочно
  subscription_expires_at        DateTime?
  // Автопродление: за сутки до конца периода списываем с основного сохранённого способа оплаты (ЮKassa)
  subscription_auto_renew        Boolean                   @default(false)
  subscription_period            String?                   @db.VarChar(10) // month | year — период для продления
  subscription_renew_attempts    Int                       @default(0)
  subscription_next_renew_at     DateTime?
  storage_used_bytes             BigInt                    @default(0)
  profile_theme                  String?                   @db.VarChar(50)
  profile_bg_url                 String?
  profile_frame                  String?                   @db.VarChar(50)
  profile_frame_id               String?                   @db.Uuid
  equippedFrame                  AvatarFrame?              @relation("EquippedFrame", fields: [profile_frame_id], references: [id], onDelete: SetNull)
  ownedAvatarFrames              UserAvatarFrame[]
  createdAvatarFrames            AvatarFrame[]             @relation("AvatarFrameCreator")
  artist_since                   DateTime?                 @db.Timestamp(6)
  verification_type              String?                   @db.VarChar(30)
  adRequests                     Advertisement[]           @relation("AdRequester")
  adReviews                      Advertisement[]           @relation("AdReviewer")
  comments                       Comment[]
  commentVotes                   CommentVote[]
  favourites                     Favourite[]
  postBookmarkLabels             PostBookmarkLabel[]
  following                      Follow[]                  @relation("UserFollowers")
  followers                      Follow[]                  @relation("UserFollowing")
  userBookmarksGiven             UserBookmark[]            @relation("UserBookmarkOwner")
  userBookmarksReceived          UserBookmark[]            @relation("UserBookmarkTarget")
  groupBookmarks                 GroupBookmark[]
  mediaHistory                   MediaHistory[]
  notifications                  Notification[]            @relation("NotificationReceiver")
  sentNotifications              Notification[]            @relation("NotificationSender")
  posts                          Post[]                    @relation("PostAuthor")
  mediaObjects                   MediaObject[]
  rewardPosts                    Post[]                    @relation("PostRewardFor")
  scheduledPosts                 ScheduledPost[]
  sentRelationshipRequests       RelationshipRequest[]     @relation("SentRelationshipRequests")
  receivedRelationshipRequests   RelationshipRequest[]     @relation("ReceivedRelationshipRequests")
  repaws                         Repaw[]
  postViews                      PostView[]
  postNotInterested              PostNotInterested[]
  tagAffinities                  UserTagAffinity[]
  reports                        Report[]                  @relation("ReportReporter")
  resolvedReports                Report[]                  @relation("ReportResolver")
  stories                        Story[]
  storyViews                     StoryView[]
  storyVotes                     StoryVote[]
  pinnedPost                     Post?                     @relation("UserPinnedPost", fields: [pinned_post_id], references: [id])
  activities                     UserActivity[]
  votes                          Vote[]
  wallet                         Wallet?
  groupTransactions              GroupTransaction[]
  conversationParticipants       ConversationParticipant[]
  groupDmConversations           Conversation[]            @relation("GroupDmUser")
  sentMessages                   Message[]
  blocksGiven                    Block[]                   @relation("Blocker")
  blocksReceived                 Block[]                   @relation("Blocked")
  sentFriendRequests             Friendship[]              @relation("FriendshipRequester")
  receivedFriendRequests         Friendship[]              @relation("FriendshipAddressee")
  is_verified                    Boolean                   @default(false)
  is_sponsor                     Boolean                   @default(false)
  verified_at                    DateTime?
  ownedGroups                    Group[]                   @relation("GroupOwner")
  groupMemberships               GroupMember[]
  groupSubscriptions             GroupSubscriber[]
  orders                         Order[]                   @relation("OrderCustomer")
  soonBadges                     SoonBadge[]
  verificationRequests           VerificationRequest[]
  groupRatings                   GroupRating[]
  groupReviews                   GroupReview[]
  groupJoinRequests              GroupJoinRequest[]
  dealerListings                 DealerListing[]
  listingApplications            ListingApplication[]
  dealerBids                     DealerBid[]
  dealerListingComments          DealerListingComment[]
  stickerPacks                   StickerPack[]
  stickerCollection              UserStickerPack[]
  stickerUsages                  StickerUsage[]
  stickerFavorites               StickerFavorite[]
  pushSubscriptions              PushSubscription[]
  push_messages                  Boolean                   @default(true)
  push_events                    Boolean                   @default(true)
  stickerAccessRequests          StickerAccessRequest[]
  autoModLogs                    AutoModLog[]
  autoModActorLogs               AutoModLog[]              @relation("AutoModActor")
  adminBroadcasts                AdminBroadcast[]
  warn_count                     Int                       @default(0)
  frozen_at                      DateTime?
  frozen_reason                  String?                   @db.VarChar(500)
  deceased_at                    DateTime?
  deceased_note                  String?                   @db.VarChar(300)
  oauthAccounts                  OAuthAccount[]
  refreshTokens                  RefreshToken[]
  eventAttendances               EventAttendee[]           @relation("UserEventAttendees")
  groupMessages                  GroupMessage[]            @relation("UserGroupMessages")
  // Activity Engine
  ownedActivities                Activity[]                @relation("ActivityOwner")
  activityParticipations         ActivityParticipant[]
  activityBlacklist              ActivityBlacklist?        @relation("ActivityBlacklistUser")
  activityBlacklistsMade         ActivityBlacklist[]       @relation("ActivityBlacklistBanner")
  // Fursona & Fursuit
  fursonas                       Fursona[]
  fursuits                       Fursuit[]
  referenceImages                FursonaReferenceImage[]
  // Shop
  shopItems                      UserShopItem[]
  // Dealers Den v2
  den_frozen                     Boolean                   @default(false)
  denTrustScore                  DenTrustScore?
  denReviewsGiven                DenReview[]               @relation("DenReviewAuthor")
  denReviewsReceived             DenReview[]               @relation("DenReviewTarget")
  denWeeklyTops                  DenWeeklyTop[]
  denWishlist                    DenWishlist[]
  denRaffleTickets               DenRaffleTicket[]
  commissionBookings             CommissionBooking[]
  disputesBuyer                  DenDispute[]              @relation("DisputeBuyer")
  disputesSeller                 DenDispute[]              @relation("DisputeSeller")
  denFairParticipations          DenFairParticipant[]
  donate_url                     String?                   @db.VarChar(500)
  conversationKeys               ConversationKey[]
  // Privacy (all: "everyone" | "friends" | "nobody", except *_visibility below which use "only_me" instead of "nobody")
  messages_privacy               String                    @default("everyone") @db.VarChar(20)
  forward_identity_privacy       String                    @default("everyone") @db.VarChar(20)
  comments_privacy               String                    @default("everyone") @db.VarChar(20)
  mentions_privacy               String                    @default("everyone") @db.VarChar(20)
  online_status_visibility       String                    @default("everyone") @db.VarChar(20)
  friends_list_visibility        String                    @default("everyone") @db.VarChar(20)
  profile_visibility             String                    @default("everyone") @db.VarChar(20)
  relationship_status_visibility String                    @default("everyone") @db.VarChar(20)
  groups_visibility              String                    @default("everyone") @db.VarChar(20)
  groups_pinned_only             Boolean                   @default(false)
  last_seen_at                   DateTime?
  payment_region                 String?                   @db.VarChar(10)
  paymentMethods                 PaymentMethod[]
  subscriptionPlans              SubscriptionPlan[]
  payments                       Payment[]
  supportTickets                 SupportTicket[]           @relation("SupportTicketUser")
  supportTicketMessages          SupportTicketMessage[]    @relation("SupportTicketMessageSender")
  albums                         Album[]
  two_factor_method              String?                   @db.VarChar(10)
  totp_secret                    String?
  totp_last_step                 Int?
  failed_login_count             Int                       @default(0)
  failed_2fa_count               Int                       @default(0)
  login_locked_until             DateTime?
  // Бан (админ или автомодерация). В отличие от самоудаления, email и username забаненного не освобождаются
  is_banned                      Boolean                   @default(false)
  // Automation settings (auto-follow-back, mute keywords, quiet hours, notify toggles)
  auto_follow_back               Boolean                   @default(false)
  mute_keywords                  String[]                  @default([])
  quiet_hours_enabled            Boolean                   @default(false)
  quiet_hours_from               String                    @default("23:00") @db.VarChar(5)
  quiet_hours_to                 String                    @default("08:00") @db.VarChar(5)
  notify_new_fan                 Boolean                   @default(true)
  notify_comment                 Boolean                   @default(true)
  notify_repaw                   Boolean                   @default(false)
  filter_spam                    Boolean                   @default(true)
}

model PaymentMethod {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  // Токен сохранённого способа оплаты в ЮKassa (payment_method.id). null — старая «карта» без токена, списать нельзя
  provider_method_id String?  @unique @db.VarChar(100)
  type               String   @default("bank_card") @db.VarChar(20) // bank_card | yoo_money | sbp
  brand              String   @db.VarChar(20)
  last4              String?  @db.VarChar(4)
  exp_month          Int?
  exp_year           Int?
  holder_name        String?  @db.VarChar(60)
  title              String?  @db.VarChar(100) // подпись от ЮKassa: «Bank card *4444», номер кошелька
  is_default         Boolean  @default(false)
  created_at         DateTime @default(now())
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// Audit trail of subscription tier changes. Table already existed in the DB
/// (created by migration 20260302300000) but was never wired into Prisma Client.
model SubscriptionPlan {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  tier       String    @default("free") @db.VarChar(20)
  starts_at  DateTime  @default(now())
  ends_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// Платёж: пополнение кошелька, оплата подписки или донат. Через внешний шлюз (ЮKassa) или с баланса.
/// Строка создаётся до редиректа на шлюз; id уходит в metadata.payment_id и возвращается в API.
model Payment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  provider              String    @db.VarChar(20) // yoomoney | wallet
  purpose               String    @db.VarChar(20) // wallet_topup | subscription | donation | card_binding
  // pending → succeeded | expired | review | refunded (возврат денег плательщику)
  // pending → succeeded | expired | review (деньги пришли, но что-то не сходится — разобрать вручную)
  // card_binding: succeeded → refunded (проверочный 1 ₽ возвращается)
  status                String    @default("pending") @db.VarChar(20)
  amount                Decimal   @db.Decimal(18, 2) // к оплате плательщиком
  credited_amount       Decimal?  @db.Decimal(18, 2) // пришло на счёт после комиссии шлюза
  currency              String    @default("RUB") @db.VarChar(3)
  method                String?   @db.VarChar(10) // AC — карта, PC — ЮMoney
  tier                  String?   @db.VarChar(20)
  period                String?   @db.VarChar(10) // month | year
  provider_operation_id String?   @unique @db.VarChar(100)
  failure_reason        String?   @db.VarChar(200)
  raw_notification      Json?
  save_method           Boolean   @default(false) // просили ЮKassa сохранить способ оплаты (привязка / автопродление)
  recurring             Boolean   @default(false) // автосписание по сохранённому способу, без участия пользователя
  blm_amount            Decimal?  @db.Decimal(18, 2) // сколько BLM зачислено/списано (фиксируется при создании)
  blm_rate              Decimal?  @db.Decimal(10, 4) // курс ₽ за 1 BLM на момент создания
  paid_at               DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, created_at])
  @@index([status, created_at])
}

/// История курса ₽ за 1 BLM (1 BLM = 1 $), обновляется по cron из курса ЦБ
model BlmRate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usd_rub    Decimal  @db.Decimal(10, 4)
  source     String   @default("cbr") @db.VarChar(20)
  created_at DateTime @default(now())

  @@index([created_at])
}

model OAuthAccount {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  provider    String   @db.VarChar(50)
  provider_id String
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
}

model EmailOtp {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  code       String   @db.VarChar(10)
  purpose    String   @db.VarChar(30)
  expires_at DateTime
  used       Boolean  @default(false)
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  @@index([email, purpose])
}

model Post {
  id                  String              @id @default(uuid()) @db.Uuid
  content             String
  author_id           String              @db.Uuid
  rating              Int                 @default(0)
  is_nsfw             Boolean             @default(false)
  is_announcement     Boolean             @default(false)
  subscriber_only     Boolean             @default(false)
  is_paid             Boolean             @default(false)
  price               Decimal?            @db.Decimal(10, 2)
  reward_for_user_id  String?             @db.Uuid
  video_title         String?             @db.VarChar(255)
  video_description   String?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  category            String?
  title               String?             @db.VarChar(200)
  post_type           String              @default("general") @db.VarChar(30)
  media_urls          String[]            @default([])
  media_original_urls String[]            @default([])
  views_count         Int                 @default(0)
  is_archived         Boolean             @default(false)
  comments_disabled   Boolean             @default(false)
  is_ai_generated     Boolean             @default(false)
  comments            Comment[]
  favourites          Favourite[]
  author              User                @relation("PostAuthor", fields: [author_id], references: [id])
  rewardForUser       User?               @relation("PostRewardFor", fields: [reward_for_user_id], references: [id])
  tags                PostTag[]
  repaws              Repaw[]
  pinnedBy            User[]              @relation("UserPinnedPost")
  groupPosts          GroupPost[]
  activities          UserActivity[]
  votes               Vote[]
  views               PostView[]
  notInterested       PostNotInterested[]

  @@index([author_id])
  @@index([deleted_at, created_at])
  @@index([rating])
  // Лента: ORDER BY created_at DESC LIMIT n — без этого индекса планировщик читал все посты
  @@index([created_at(sort: Desc)])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([media_urls], type: Gin)
  @@index([media_original_urls], type: Gin)
}

// Файл в хранилище и его владелец. Объекты без записи (загружены до введения учёта)
// не имеют владельца: их нельзя прикреплять к новому контенту и удалять через API.
model MediaObject {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  object_key String    @unique @db.VarChar(255)
  owner_id   String?   @db.Uuid
  folder     String    @db.VarChar(40)
  size_bytes BigInt
  created_at DateTime  @default(now())
  deleted_at DateTime?

  owner User? @relation(fields: [owner_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
}

/// Explicit "не интересно" feedback — unlike a soft skip/scroll-past, this permanently excludes
/// the post from that user's personalized feed and applies a stronger negative affinity signal
/// than a passive view (see markNotInterested / toggleVote's downvote path for the analogous flow).
model PostNotInterested {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  post_id     String   @db.Uuid
  /// Snapshot of the {term: delta} affinity deltas this applied — lets undo precisely reverse it.
  term_deltas Json?
  created_at  DateTime @default(now())
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

/// A post that hasn't gone live yet — either a draft (no scheduled_at) or queued for
/// automatic publication (scheduled_at set). Deliberately NOT a Post row: keeping
/// unpublished content out of the Post table means every existing feed/search/profile
/// query stays correct without modification. Turned into a real Post (via
/// postService.createPost / groupService.createGroupPost) only at publish time —
/// see scheduledService.publishDueOnes.
model ScheduledPost {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id           String    @db.Uuid
  group_id            String?   @db.Uuid
  content             String
  media_urls          String[]  @default([])
  media_original_urls String[]  @default([])
  is_nsfw             Boolean   @default(false)
  is_ai_generated     Boolean   @default(false)
  category            String?
  tags                String[]  @default([])
  /// draft | scheduled | published | failed
  status              String    @default("scheduled") @db.VarChar(20)
  scheduled_at        DateTime?
  /// IANA zone, display-only — scheduled_at is already stored as UTC
  timezone            String?   @db.VarChar(64)
  /// null | daily | weekly | monthly
  repeat_interval     String?   @db.VarChar(20)
  repeat_until        DateTime?
  occurrences_count   Int       @default(0)
  last_error          String?
  published_post_id   String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  author User   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  group  Group? @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([status, scheduled_at])
  @@index([author_id])
}

/// One row per (post, viewer) — the source of truth for Post.views_count, so a
/// person re-opening the same post in a new tab/session never inflates the count.
model PostView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

model Repaw {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  post_id     String   @db.Uuid
  /// Snapshot of the {term: delta} affinity deltas this repost applied to UserTagAffinity —
  /// lets toggleRepaw precisely undo it if the repost is retracted.
  term_deltas Json?
  created_at  DateTime @default(now())
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

model Favourite {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String             @db.Uuid
  post_id    String             @db.Uuid
  label_id   String?            @db.Uuid
  created_at DateTime           @default(now())
  post       Post               @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [user_id], references: [id])
  label      PostBookmarkLabel? @relation(fields: [label_id], references: [id], onDelete: SetNull)

  @@unique([user_id, post_id])
  @@index([label_id])
  @@index([post_id])
}

model PostBookmarkLabel {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @db.VarChar(60)
  color      String   @default("#4C67CF") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  favourites Favourite[]

  @@index([user_id])
}

model Tag {
  id    String    @id @default(uuid()) @db.Uuid
  name  String    @unique
  posts PostTag[]
}

// Синоним хештега: alias → canonical. Теги в постах не переписываются — синонимы
// объединяются только в популярных тегах и в поиске с включёнными синонимами.
// Варианты с «_» и «-» (furry_art / furry-art / furryart) склеиваются автоматически, их сюда не заносят.
model TagSynonym {
  alias      String   @id @db.VarChar(100)
  canonical  String   @db.VarChar(100)
  created_by String?  @db.Uuid
  created_at DateTime @default(now())

  @@index([canonical])
}

model PostTag {
  post_id String @db.Uuid
  tag_id  String @db.Uuid
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tag_id], references: [id])

  @@id([post_id, tag_id])
}

model Story {
  id         String      @id @default(uuid()) @db.Uuid
  user_id    String      @db.Uuid
  image_url  String?
  video_url  String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted_at DateTime?
  expires_at DateTime
  user       User        @relation(fields: [user_id], references: [id])
  views      StoryView[]
  votes      StoryVote[]

  @@index([user_id])
  @@index([created_at])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([image_url])
  @@index([video_url])
}

model StoryView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())
  story      Story    @relation(fields: [story_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([story_id, user_id])
  @@index([story_id])
}

model StoryVote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id   String   @db.Uuid
  user_id    String   @db.Uuid
  value      Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  story      Story    @relation(fields: [story_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([story_id, user_id])
  @@index([story_id])
}

model Vote {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  post_id     String    @db.Uuid
  value       Int
  /// Snapshot of the {term: delta} affinity deltas this vote applied to UserTagAffinity —
  /// lets toggleVote precisely undo/re-derive on retract or flip without recomputing history.
  term_deltas Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  post        Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
  @@index([post_id])
}

/// Per-user, per-term (hashtag or content keyword) behavioral affinity for the feed algorithm.
/// `score` drives ranking (weighted, fed by likes/dislikes/reposts — see postService.applyTermDeltas);
/// `likes`/`dislikes` are plain counts kept for the settings "tag cloud" UI.
model UserTagAffinity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  term       String   @db.VarChar(60)
  source     String   @default("tag") @db.VarChar(20) // tag | keyword
  score      Float    @default(0)
  likes      Int      @default(0)
  dislikes   Int      @default(0)
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, term])
  @@index([user_id, score])
}

model Wallet {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @unique @db.Uuid
  balance    Decimal   @default(0.00) @db.Decimal(18, 2)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  user       User      @relation(fields: [user_id], references: [id])
}

/// Журнал движения Bloom: каждая запись — одно изменение баланса (amount со знаком), balance_after — остаток после него.
/// Только дописывается; баланс кошелька всегда равен сумме записей (кроме истории до появления журнала).
model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  amount        Decimal  @db.Decimal(18, 2)
  balance_after Decimal  @db.Decimal(18, 2)
  kind          String   @db.VarChar(30) // topup | subscription | sticker_purchase | sticker_sale | shop_purchase | group_donation | dev_topup
  ref_id        String?  @db.VarChar(100) // платёж / пак / товар / группа
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@index([kind, ref_id])
}

model UserActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  type       String
  duration   Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
}

model Comment {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String        @db.Uuid
  author_id  String        @db.Uuid
  /// Set when the real author (still author_id) posted this comment "as" a group they
  /// manage — the API masks author_id in the response and shows the group instead.
  group_id   String?       @db.Uuid
  parent_id  String?       @db.Uuid
  content    String
  type       String        @default("text")
  file_url   String?
  rating     Int           @default(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  deleted_at DateTime?
  author     User          @relation(fields: [author_id], references: [id])
  group      Group?        @relation(fields: [group_id], references: [id])
  parent     Comment?      @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[]     @relation("CommentReplies")
  post       Post          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  votes      CommentVote[]

  @@index([post_id])
  @@index([parent_id])
  @@index([group_id])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([file_url])
}

model CommentVote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  comment_id String    @db.Uuid
  value      Int
  created_at DateTime  @default(now())
  deleted_at DateTime?
  comment    Comment   @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, comment_id])
  @@index([comment_id])
}

model Follow {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  follower_id  String   @db.Uuid
  following_id String   @db.Uuid
  created_at   DateTime @default(now())
  notify_posts Boolean  @default(false)
  follower     User     @relation("UserFollowers", fields: [follower_id], references: [id])
  following    User     @relation("UserFollowing", fields: [following_id], references: [id])

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiver_id     String    @db.Uuid
  sender_id       String?   @db.Uuid
  /// Set when the action was taken "as" a group (mirrors Comment.group_id) — the sender's
  /// personal identity should be masked in favor of the group's name/avatar for display.
  sender_group_id String?   @db.Uuid
  type            String
  post_id         String?   @db.Uuid
  comment_id      String?   @db.Uuid
  read            Boolean   @default(false)
  created_at      DateTime  @default(now())
  deleted_at      DateTime?
  ref_id          String?   @db.Uuid
  /// Small structured payload for system notifications (e.g. AutoMod warn count/reason) — not used by social notifications
  meta            Json?
  receiver        User      @relation("NotificationReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender          User?     @relation("NotificationSender", fields: [sender_id], references: [id])
  senderGroup     Group?    @relation("NotificationSenderGroup", fields: [sender_group_id], references: [id])

  @@index([receiver_id])
  @@index([receiver_id, read], map: "Notification_receiver_read_idx")
  @@index([receiver_id, deleted_at])
}

model Advertisement {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  image_url    String?
  link_url     String
  contact_info String?
  price_label  String?   @db.VarChar(60)
  status       String    @default("pending")
  requester_id String?   @db.Uuid
  reviewed_by  String?   @db.Uuid
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  starts_at    DateTime?
  ends_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  deleted_at   DateTime?
  requester    User?     @relation("AdRequester", fields: [requester_id], references: [id])
  reviewer     User?     @relation("AdReviewer", fields: [reviewed_by], references: [id])
}

model MediaHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  url        String
  video_url  String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([url])
}

model Report {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id   String    @db.Uuid
  target_type   String
  target_id     String    @db.Uuid
  reason        String
  status        String    @default("pending")
  resolved_by   String?   @db.Uuid
  note          String?
  priority      Int       @default(0)
  ai_category   String?   @db.VarChar(50)
  ai_score      Float     @default(0)
  evidence_urls String[]  @default([])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  deleted_at    DateTime?
  reporter      User      @relation("ReportReporter", fields: [reporter_id], references: [id])
  resolver      User?     @relation("ReportResolver", fields: [resolved_by], references: [id])

  @@index([status])
  @@index([priority(sort: Desc), status])
}

model AutoModLog {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  actor_id           String?   @db.Uuid // staff member who performed a manual action; null for AutoMod-originated entries
  action             String    @db.VarChar(50)
  reason             String    @db.VarChar(300)
  category           String    @default("other") @db.VarChar(50)
  score              Float     @default(0)
  details            String?
  post_id            String?   @db.Uuid
  image_url          String? // evidence photo attached by a moderator when resolving a report with a warning
  appeal_status      String    @default("none") @db.VarChar(20) // 'none' | 'pending' | 'accepted' | 'rejected'
  appeal_text        String?
  appeal_created_at  DateTime?
  appeal_resolved_at DateTime?
  appeal_resolved_by String?   @db.Uuid
  created_at         DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  actor              User?     @relation("AutoModActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([created_at])
  @@index([action])
  @@index([appeal_status])
}

model AdminBroadcast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id        String   @db.Uuid
  title           String   @db.VarChar(200)
  body            String   @db.VarChar(2000)
  audience        String   @db.VarChar(30) // all | premium | new | staff
  recipient_count Int      @default(0)
  created_at      DateTime @default(now())
  actor           User     @relation(fields: [actor_id], references: [id])

  @@index([created_at])
}

model SiteSetting {
  key        String   @id @db.VarChar(50)
  value      Boolean  @default(false)
  updated_at DateTime @default(now()) @updatedAt
}

model RelationshipRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_id    String   @db.Uuid
  to_id      String   @db.Uuid
  status     String   @default("pending") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  from       User     @relation("SentRelationshipRequests", fields: [from_id], references: [id], onDelete: Cascade)
  to         User     @relation("ReceivedRelationshipRequests", fields: [to_id], references: [id], onDelete: Cascade)

  @@unique([from_id, to_id], map: "RelationshipRequest_from_to_unique")
  @@index([to_id, status])
}

// ── Messages ──────────────────────────────────────────────────────────────────

model Conversation {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt
  deleted_at       DateTime?
  type             String                    @default("direct") @db.VarChar(20) // direct | group | community
  is_group         Boolean                   @default(false) // kept for back-compat; type='group' ⇒ is_group=true. type='community' is a 1:1-style thread and stays false.
  name             String?                   @db.VarChar(100)
  avatar_url       String?
  banner_url       String?
  group_id         String?                   @db.Uuid // set when type='community'; many conversations share the same group_id (one per group_dm_user_id)
  group_dm_user_id String?                   @db.Uuid // set when type='community': the regular member's personal thread with the group; null on legacy shared group rooms
  participants     ConversationParticipant[]
  messages         Message[]
  keys             ConversationKey[]
  group            Group?                    @relation("GroupCommunityChat", fields: [group_id], references: [id], onDelete: SetNull)
  group_dm_user    User?                     @relation("GroupDmUser", fields: [group_dm_user_id], references: [id], onDelete: Cascade)

  pinned_message_id String?  @db.Uuid
  pinnedMessage     Message? @relation("ConvPinnedMessage", fields: [pinned_message_id], references: [id], onDelete: SetNull)

  order Order? @relation("OrderConversation")

  @@unique([group_id, group_dm_user_id])
  @@index([group_id])
}

model ConversationKey {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  user_id         String       @db.Uuid
  encrypted_key   String // AES-256 conversation key encrypted with user's RSA-OAEP public key, base64
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id])
}

model Friendship {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id String   @db.Uuid
  addressee_id String   @db.Uuid
  status       String   @default("pending") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(6)
  requester    User     @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee    User     @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, addressee_id])
  @@index([addressee_id, status])
  @@index([requester_id])
}

model Block {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now())
  blocker    User     @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
}

model ConversationParticipant {
  conversation_id            String       @db.Uuid
  user_id                    String       @db.Uuid
  archived                   Boolean      @default(false)
  hidden_at                  DateTime?
  last_read_at               DateTime?
  role                       String       @default("member") @db.VarChar(20)
  label                      String       @default("default") @db.VarChar(20) // default | customer
  personal_pinned_message_id String?      @db.Uuid
  muted_until                DateTime? // null = not muted; far-future = muted indefinitely
  sound_muted                Boolean      @default(false) // sound off, but toast/badge still shown
  conversation               Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user                       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@index([user_id, label])
}

model Message {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id          String         @db.Uuid
  sender_id                String         @db.Uuid
  text                     String?
  encrypted_text           String? // AES-GCM ciphertext: base64(iv[12] + ciphertext), null for plaintext messages
  type                     String         @default("text")
  file_url                 String?
  reply_to_id              String?        @db.Uuid
  reactions                Json?
  metadata                 Json? // structured payload for card-style messages (payment_request, payment_confirmation, tip)
  edited_at                DateTime?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  deleted_at               DateTime?
  forwarded_from_id        String?        @db.Uuid // original message id
  forwarded_from_sender_id String?        @db.Uuid // original sender id
  forwarded_from_conv_id   String?        @db.Uuid // original conversation id
  conversation             Conversation   @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender                   User           @relation(fields: [sender_id], references: [id])
  reply_to                 Message?       @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies                  Message[]      @relation("MessageReplies")
  pinnedInConvs            Conversation[] @relation("ConvPinnedMessage")

  @@index([conversation_id, created_at(sort: Desc)])
  @@index([reply_to_id])
  @@index([sender_id, created_at])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([file_url])
}

// ── Groups ────────────────────────────────────────────────────────────────────

model Group {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albums       Album[]
  slug         String    @unique @db.VarChar(60)
  slug_aliases String[]  @default([]) // Old slugs kept for redirect
  name         String    @db.VarChar(120)
  description  String?
  type         String    @db.VarChar(20) // event | creative | static
  owner_id     String    @db.Uuid
  avatar_url   String?
  banner_url   String?
  accent_color String?   @db.VarChar(20)
  social_links Json?     @default("{}")
  is_public    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  den_enabled   Boolean   @default(false) // Dealers Den подключён: от имени группы можно создавать лоты
  den_agreed_at DateTime? @db.Timestamp(6) // когда владелец подтвердил, что не скамер, и принял правила

  // Extended fields
  rules_text    String? // Правила группы (markdown)
  faq           Json?   @default("[]") // [{q: "...", a: "..."}]
  contact_phone String? @db.VarChar(30)
  contact_email String? @db.VarChar(120)
  about_text    String? // Расширенное описание
  schedule      Json?   @default("[]") // [{time: "09:30-10:00", label: "..."}]
  what_to_bring Json?   @default("[]") // ["Коврик", "Вода"]
  is_nsfw       Boolean @default(false)
  rating        Float   @default(0)
  rating_count  Int     @default(0)
  members_count Int     @default(0)

  // Creative-specific
  production_time String? @db.VarChar(100) // "2-3 месяца"
  delivery_info   String? @db.VarChar(200) // "Доставка по всему миру"
  completed_works Int     @default(0)
  guarantee_text  String? @db.VarChar(300)

  // Event-specific
  sponsors Json @default("[]") // [{name, logo_url, url, tier?}]

  // Business customization
  group_bg_url      String?
  group_frame       String? @db.VarChar(100)
  group_theme       String? @db.VarChar(100)
  hide_admins       Boolean @default(false)
  hidden_member_ids String  @default("[]")

  // Donations & support tiers
  donations_enabled Boolean @default(false)
  bank_card_masked  String? @db.VarChar(25) // e.g. "**** **** **** 4242"
  support_tiers     Json    @default("[]") // [{emoji,name,price,desc}]

  // Moderation / discovery
  is_verified         Boolean   @default(false) // Official / verified community
  category            String?   @db.VarChar(50) // art | cosplay | fandom | dev | music | etc.
  category_changed_at DateTime? // last time category was changed — gates 1x/month cooldown
  rubric              String?   @db.VarChar(50) // news | brand sub-category picked at creation (separate from category)

  // Event lifecycle (type == "event" only) — admin-set date; once past, SOON badges are cleared
  // and plain members are demoted to notification-only subscribers until a new date is set.
  event_date       DateTime? // NULL = feature inactive for this group
  event_expired_at DateTime? // set once the expiry sweep has run for the current event_date

  // Business tab (orders/kanban) — owner-toggleable, independent of `type`
  business_enabled Boolean @default(false)

  // Auto-reply sent (as the owner) the first time a member writes into the group's
  // personal community-DM thread with them — see messages/service.ts _maybeSendGroupWelcome
  welcome_msg_enabled Boolean @default(false)
  welcome_msg_text    String? @db.VarChar(300)

  // Custom Todolist kanban columns — [{key,label,color,icon}]; empty/null = use default 5-stage set
  todo_columns Json? @default("[]")

  // Group balance — credited by member donations (Wallet-funded), spent by the owner outside the app for now
  balance Decimal @default(0.00) @db.Decimal(18, 2)

  owner             User               @relation("GroupOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members           GroupMember[]
  events            Event[]
  commissionInfo    CommissionInfo?
  posts             GroupPost[]
  comments          Comment[]
  ratings           GroupRating[]
  reviews           GroupReview[]
  joinRequests      GroupJoinRequest[]
  groupMessages     GroupMessage[]
  groupDmThreads    Conversation[]     @relation("GroupCommunityChat")
  activities        Activity[]
  todoItems         GroupTodoItem[]
  customRoles       GroupCustomRole[]
  bookmarks         GroupBookmark[]
  subscribers       GroupSubscriber[]
  orders            Order[]
  transactions      GroupTransaction[]
  sentNotifications Notification[]     @relation("NotificationSenderGroup")
  scheduledPosts    ScheduledPost[]
  dealerListings    DealerListing[]
  listingApplications ListingApplication[]

  @@index([owner_id])
  @@index([type])
}

// ── Group balance ledger — funded by member donations from their personal Wallet ──
model GroupTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String?  @db.Uuid // donor; null for system adjustments
  type       String   @db.VarChar(20) // DONATION | ADJUSTMENT
  amount     Decimal  @db.Decimal(18, 2)
  message    String?  @db.VarChar(280)
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([group_id, created_at])
}

model GroupRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  value      Int // -1 (downvote) or 1 (upvote) — Reddit-style
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id])
}

// Text review with 1..5 stars (separate from the up/down GroupRating score)
model GroupReview {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Int // 1..5
  text       String   @db.VarChar(2000)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id, created_at])
}

// Join application for closed groups (is_public = false): admins approve or reject it
model GroupJoinRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  message    String?  @db.VarChar(500)
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id, created_at])
}

enum TodoStatus {
  WAITING
  SKETCH
  LINEART
  COLORING
  FINISHED
}

model GroupTodoItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String    @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  status      String    @default("WAITING") @db.VarChar(30) // key of a Group.todo_columns entry (or default stage)
  position    Int       @default(0)
  /// Заказ, который стоит в очереди: статус пункта и этап заказа синхронизируются в обе стороны
  order_id    String?   @unique @db.Uuid
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  group Group  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  order Order? @relation("OrderTodoItem", fields: [order_id], references: [id], onDelete: SetNull)

  @@index([group_id])
  @@index([group_id, deleted_at])
}

// ── Group Business tab: Orders ──────────────────────────────────────────────
model Order {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id        String     @db.Uuid
  customer_id     String     @db.Uuid
  title           String     @db.VarChar(200)
  description     String?
  form_data       Json?
  status          TodoStatus @default(WAITING)
  position        Int        @default(0)
  deadline_at     DateTime?
  started_at      DateTime? // когда исполнитель взял заказ в работу (и поставил дедлайн)
  finished_at     DateTime? // когда заказ перешёл в «Готово»
  conversation_id String?    @unique @db.Uuid
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  todoItem     GroupTodoItem? @relation("OrderTodoItem")
  group        Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  customer     User          @relation("OrderCustomer", fields: [customer_id], references: [id], onDelete: Cascade)
  conversation Conversation? @relation("OrderConversation", fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([group_id, deleted_at])
  @@index([customer_id])
  @@index([deadline_at])
}

model GroupCustomRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String   @db.Uuid
  name        String   @db.VarChar(50)
  color       String   @default("#9ca3af") @db.VarChar(20)
  icon        String   @default("🎖️") @db.VarChar(20)
  permissions Json     @default("[]")
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group   Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([group_id])
}

model GroupMember {
  group_id     String   @db.Uuid
  user_id      String   @db.Uuid
  role         String   @default("member") @db.VarChar(20) // owner | admin | moderator | member | dealer | volunteer | guest_of_honor
  joined_at    DateTime @default(now())
  is_pinned    Boolean  @default(false)
  notify_posts Boolean  @default(true)
  // Optional custom role from the group's own role list: adds its permissions on top of `role`
  custom_role_id String? @db.Uuid

  group      Group            @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  customRole GroupCustomRole? @relation(fields: [custom_role_id], references: [id], onDelete: SetNull)

  @@id([group_id, user_id])
  @@index([user_id])
  @@index([custom_role_id])
}

// Notification-only follower — created when a participant is demoted after their group's
// event_date lapses, or chosen directly by a user who wants updates without joining.
model GroupSubscriber {
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([group_id, user_id])
  @@index([user_id])
}

model GroupPost {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  post_id    String   @db.Uuid
  pinned     Boolean  @default(false)
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([group_id, post_id])
}

// ── Events (афиша) ────────────────────────────────────────────────────────────

model Event {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id       String   @db.Uuid
  title          String   @db.VarChar(200)
  short_code     String   @db.VarChar(10) // FURM, EF, etc.
  description    String?
  banner_url     String?
  location_name  String?  @db.VarChar(200)
  location_lat   Float?
  location_lng   Float?
  starts_at      DateTime
  ends_at        DateTime
  status         String   @default("announced") @db.VarChar(30)
  is_recurring   Boolean  @default(false)
  theme          Json?    @default("{}")
  attendee_count Int      @default(0)
  is_top         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Extended fields
  schedule         Json?   @default("[]") // [{time, label}]
  what_to_bring    Json?   @default("[]") // string[]
  rules_text       String?
  faq              Json?   @default("[]") // [{q, a}]
  registration_url String? @db.VarChar(500) // External registration link

  group      Group           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  tickets    TicketTier[]
  soonBadges SoonBadge[]
  attendees  EventAttendee[]
  subEvents  SubEvent[]

  @@index([group_id])
  @@index([starts_at])
  @@index([status])
}

// ── Sub-events (panels, workshops within a main Event) ────────────────────────

model SubEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String    @db.Uuid
  title         String    @db.VarChar(200)
  type          String    @default("panel") @db.VarChar(50) // panel | workshop | performance | other
  speaker       String?   @db.VarChar(200)
  location_name String?   @db.VarChar(200)
  starts_at     DateTime
  ends_at       DateTime?
  description   String?
  created_at    DateTime  @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([starts_at])
}

model TicketTier {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String    @db.Uuid
  name           String    @db.VarChar(100)
  price          Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD") @db.VarChar(10)
  total_count    Int
  sold_count     Int       @default(0)
  sale_starts_at DateTime?
  sale_ends_at   DateTime?
  description    String? // Short description of what's included
  perks          String[]  @default([]) // ["Одноместный", "Разовое питание"]
  created_at     DateTime  @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
}

// ── SOON Badge ────────────────────────────────────────────────────────────────

model SoonBadge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  event_id   String   @db.Uuid
  show_badge Boolean  @default(true)
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
  @@index([user_id])
  @@index([event_id])
}

// ── Event RSVP (Attendees) ───────────────────────────────────────────

model EventAttendee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String   @db.Uuid
  user_id      String   @db.Uuid
  status       String   @default("going") @db.VarChar(20) // going | maybe | not_going
  confirmed_at DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation("UserEventAttendees", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

// ── Commission Info (для Creative-групп) ──────────────────────────────────────

model CommissionInfo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String   @unique @db.Uuid
  status      String   @default("closed") @db.VarChar(20) // open | closed | waitlist
  base_prices Json?    @default("{}")
  currency    String   @default("USD") @db.VarChar(10)
  tos_text    String?
  max_queue   Int      @default(5)
  updated_at  DateTime @updatedAt

  // Extended
  rush_slots      Int     @default(0) // быстрые заказы - свободные слоты
  rush_max        Int     @default(0)
  turnaround_days String? @db.VarChar(30) // "5-7 дней"
  price_list      Json?   @default("[]") // [{name, price, description}]

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

// ── Group Messages (realtime group chat) ───────────────────────────────────

model GroupMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String    @db.Uuid
  user_id    String    @db.Uuid
  text       String
  created_at DateTime  @default(now())
  deleted_at DateTime?

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation("UserGroupMessages", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at(sort: Desc)])
  @@index([user_id])
}

// ── Verification Requests ─────────────────────────────────────────────────────

model VerificationRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  status            String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  reason            String?   @db.VarChar(500) // rejection reason or notes
  // Criteria snapshot at request time
  account_age_days  Int       @default(0)
  post_count        Int       @default(0)
  has_avatar        Boolean   @default(false)
  has_bio           Boolean   @default(false)
  has_email         Boolean   @default(false)
  follower_count    Int       @default(0)
  // Timestamps
  created_at        DateTime  @default(now())
  reviewed_at       DateTime?
  reviewed_by       String?   @db.Uuid
  verification_type String?   @db.VarChar(30) // artist, master, fursuiter, popular, writer, organizer, event, photographer, programmer
  evidence_urls     String[]  @default([])
  evidence_text     String?   @db.VarChar(2000) // optional written explanation, alongside or instead of uploaded evidence
  badge_type        String?   @db.VarChar(30) // verified, artist, master, event

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

// ── Dealers Den ───────────────────────────────────────────────────────────────

model DealerListing {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id              String    @db.Uuid
  group_id               String?   @db.Uuid // группа-продавец; null у старых лотов до привязки
  title                  String    @db.VarChar(200)
  description            String?
  price                  Decimal   @default(0) @db.Decimal(12, 2)
  discount_percent       Int       @default(0) // скидка на карточку, 0–90 %; price хранит цену без скидки
  currency               String    @default("USD") @db.VarChar(10)
  category               String    @default("other") @db.VarChar(50) // art | fursuit | badge | print | music | craft | merch | other
  type                   String    @default("physical") @db.VarChar(20) // digital | physical | both
  listing_kind           String    @default("fixed") @db.VarChar(20) // fixed | auction | ych | raffle | commission_queue
  images                 String[]  @default([])
  status                 String    @default("active") @db.VarChar(20) // active | sold | draft | archived
  quantity               Int       @default(1)
  quantity_sold          Int       @default(0)
  is_nsfw                Boolean   @default(false)
  tags                   String[]  @default([])
  // ── Auction / YCH / Raffle fields ──────────────────────────────────────────
  auction_ends_at        DateTime? @db.Timestamp(6)
  current_bid            Decimal?  @db.Decimal(12, 2)
  bid_count              Int       @default(0)
  bid_increment          Decimal   @default(1) @db.Decimal(12, 2)
  auto_buy_price         Decimal?  @db.Decimal(12, 2)
  raffle_max_tickets     Int?
  raffle_tickets_sold    Int       @default(0)
  winner_id              String?   @db.Uuid
  // ── Commission Queue fields ─────────────────────────────────────────────────
  commission_slots_total Int?
  commission_slots_taken Int       @default(0)
  commission_eta_days    Int?
  commission_form_fields Json?     @default("[]")
  commission_details     Json?     // { formats, addons, draws, doesntDraw, sections, terms }
  views_count            Int       @default(0)
  // ────────────────────────────────────────────────────────────────────────────
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deleted_at             DateTime? @db.Timestamp(6)

  seller           User                   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  group            Group?                 @relation(fields: [group_id], references: [id], onDelete: SetNull)
  bids             DealerBid[]
  comments         DealerListingComment[]
  reviews          DenReview[]
  wishlistItems    DenWishlist[]
  raffleTickets    DenRaffleTicket[]
  bookings         CommissionBooking[]
  applications     ListingApplication[]
  disputes         DenDispute[]
  fairParticipants DenFairParticipant[]
  avatarFrame      AvatarFrame?

  @@index([seller_id])
  @@index([group_id])
  @@index([status])
  @@index([category])
  @@index([listing_kind])
  @@index([auction_ends_at])
  @@index([created_at(sort: Desc)])
}

// Заявка покупателя на лот Dealers' Den. Уходит только в группу-продавца (не в личные сообщения):
// группа сама пишет заявителю первой. Одна заявка на пользователя и лот.
model ListingApplication {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id   String    @db.Uuid
  group_id     String    @db.Uuid
  applicant_id String    @db.Uuid
  message      String    @db.VarChar(1000)
  /// Персонажи в заявке: [{ userId, fursonaId?, extraImages[] }] — референсы подтягиваются из профилей на лету
  characters   Json      @default("[]")
  /// Заказ в очереди группы, созданный при принятии заявки
  order_id     String?   @db.Uuid
  status       String    @default("pending") @db.VarChar(20) // pending | contacted | accepted | declined
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  resolved_at  DateTime? @db.Timestamp(6)

  listing   DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  group     Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  applicant User          @relation(fields: [applicant_id], references: [id], onDelete: Cascade)

  @@unique([listing_id, applicant_id])
  @@index([group_id, status, created_at(sort: Desc)])
  @@index([applicant_id])
}

// ── Avatar Frames ─────────────────────────────────────────────────────────────

model AvatarFrame {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id       String?   @unique @db.Uuid
  creator_id       String    @db.Uuid
  name             String    @db.VarChar(120)
  image_url        String
  price            Decimal   @default(0) @db.Decimal(10, 2)
  default_offset_x Float     @default(0)
  default_offset_y Float     @default(0)
  default_scale    Float     @default(1)
  default_rotation Float     @default(0)
  status           String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  rejection_reason String?
  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  deleted_at       DateTime? @db.Timestamp(6)

  creator    User              @relation("AvatarFrameCreator", fields: [creator_id], references: [id], onDelete: Cascade)
  listing    DealerListing?    @relation(fields: [listing_id], references: [id], onDelete: SetNull)
  owners     UserAvatarFrame[]
  equippedBy User[]            @relation("EquippedFrame")

  @@index([status])
  @@index([creator_id])
}

model UserAvatarFrame {
  user_id     String   @db.Uuid
  frame_id    String   @db.Uuid
  offset_x    Float    @default(0)
  offset_y    Float    @default(0)
  scale       Float    @default(1)
  rotation    Float    @default(0)
  acquired_at DateTime @default(now()) @db.Timestamp(6)

  user  User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  frame AvatarFrame @relation(fields: [frame_id], references: [id], onDelete: Cascade)

  @@id([user_id, frame_id])
}

model DenTrustScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
  score           Int      @default(0)
  tier            String   @default("new")
  total_deals     Int      @default(0)
  completed_deals Int      @default(0)
  disputes_lost   Int      @default(0)
  avg_rating      Decimal  @default(0) @db.Decimal(3, 2)
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model DenReview {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id  String    @db.Uuid
  reviewer_id String    @db.Uuid
  seller_id   String    @db.Uuid
  rating      Int
  tags        String[]  @default([])
  text        String?   @db.VarChar(1000)
  photo_url   String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  listing  DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  reviewer User          @relation("DenReviewAuthor", fields: [reviewer_id], references: [id])
  seller   User          @relation("DenReviewTarget", fields: [seller_id], references: [id])

  @@unique([listing_id, reviewer_id])
  @@index([seller_id])
  @@index([listing_id])
}

model DenWeeklyTop {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  rank        Int
  week_start  DateTime @db.Date
  sales_count Int
  avg_rating  Decimal  @db.Decimal(3, 2)
  new_reviews Int
  score       Decimal  @db.Decimal(10, 2)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, week_start])
  @@index([week_start, rank])
}

// One row per ticket bought in a raffle. The raffle_tickets_sold counter on DealerListing
// is kept in step with these rows; the rows are what a winner is drawn from.
model DenRaffleTicket {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id String   @db.Uuid
  buyer_id   String   @db.Uuid
  created_at DateTime @default(now())

  listing DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer   User          @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  // One ticket per person per raffle; the DB enforces it so racing purchases can't both succeed.
  @@unique([listing_id, buyer_id])
  @@index([listing_id])
}

model DenWishlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  listing_id String   @db.Uuid
  created_at DateTime @default(now())

  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@index([listing_id])
}

model CommissionBooking {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id     String    @db.Uuid
  buyer_id       String    @db.Uuid
  queue_position Int
  form_data      Json?
  status         String    @default("pending")
  notes          String?   @db.VarChar(2000)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  listing DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer   User          @relation(fields: [buyer_id], references: [id])

  @@index([listing_id, queue_position])
  @@index([buyer_id])
}

model DenDispute {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id   String    @db.Uuid
  buyer_id     String    @db.Uuid
  seller_id    String    @db.Uuid
  reason       String    @db.VarChar(2000)
  status       String    @default("open")
  seller_reply String?   @db.VarChar(2000)
  resolved_by  String?   @db.Uuid
  resolution   String?   @db.VarChar(500)
  opened_at    DateTime  @default(now())
  replied_at   DateTime?
  resolved_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  listing DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer   User          @relation("DisputeBuyer", fields: [buyer_id], references: [id])
  seller  User          @relation("DisputeSeller", fields: [seller_id], references: [id])

  @@index([listing_id])
  @@index([buyer_id])
  @@index([seller_id])
}

model DenFair {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  theme       String?   @db.VarChar(100)
  banner_url  String?
  starts_at   DateTime
  ends_at     DateTime
  status      String    @default("upcoming")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  participants DenFairParticipant[]
}

model DenFairParticipant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fair_id    String   @db.Uuid
  user_id    String   @db.Uuid
  listing_id String?  @db.Uuid
  status     String   @default("pending")
  created_at DateTime @default(now())

  fair    DenFair        @relation(fields: [fair_id], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [user_id], references: [id])
  listing DealerListing? @relation(fields: [listing_id], references: [id])

  @@unique([fair_id, user_id])
}

model DealerBid {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id String   @db.Uuid
  bidder_id  String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  message    String?
  created_at DateTime @default(now()) @db.Timestamp(6)

  listing DealerListing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  bidder  User          @relation(fields: [bidder_id], references: [id], onDelete: Cascade)

  @@index([listing_id])
  @@index([bidder_id])
  @@index([created_at(sort: Desc)])
}

model DealerListingComment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id String    @db.Uuid
  author_id  String    @db.Uuid
  body       String    @db.VarChar(2000)
  parent_id  String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)

  listing DealerListing          @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  author  User                   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent  DealerListingComment?  @relation("DealerCommentReplies", fields: [parent_id], references: [id])
  replies DealerListingComment[] @relation("DealerCommentReplies")

  @@index([listing_id])
  @@index([author_id])
  @@index([parent_id])
  @@index([created_at(sort: Desc)])
}

// ── Stickers ──────────────────────────────────────────────────────────────────

model StickerPack {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id         String    @db.Uuid
  name              String    @db.VarChar(120)
  description       String?
  cover_url         String?
  cover_bg_color    String?   @db.VarChar(60)
  cover_sticker_idx Int?
  stickers          String[]  @default([])
  nsfw_stickers     Int[]     @default([])
  price             Decimal   @default(0) @db.Decimal(10, 2)
  currency          String    @default("USD") @db.VarChar(10)
  tags              String[]  @default([])
  is_nsfw           Boolean   @default(false)
  status            String    @default("published") @db.VarChar(20) // published | draft
  downloads_count   Int       @default(0)
  use_count         Int       @default(0)
  hide_author       Boolean   @default(false)
  visibility        String    @default("public") @db.VarChar(20) // own | public | invite | paid
  invite_code       String?   @unique @db.VarChar(32)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deleted_at        DateTime? @db.Timestamp(6)

  author           User                   @relation(fields: [author_id], references: [id], onDelete: Cascade)
  userCollections  UserStickerPack[]
  stickerUsages    StickerUsage[]
  stickerFavorites StickerFavorite[]
  accessRequests   StickerAccessRequest[]

  @@index([author_id])
  @@index([status])
  @@index([visibility])
  @@index([created_at(sort: Desc)])
}

model UserStickerPack {
  user_id  String   @db.Uuid
  pack_id  String   @db.Uuid
  added_at DateTime @default(now()) @db.Timestamp(6)

  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pack StickerPack @relation(fields: [pack_id], references: [id], onDelete: Cascade)

  @@id([user_id, pack_id])
  @@index([user_id])
  @@index([pack_id])
}

model StickerUsage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  sticker_url  String
  pack_id      String?  @db.Uuid
  use_count    Int      @default(1)
  last_used_at DateTime @default(now()) @db.Timestamp(6)

  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pack StickerPack? @relation(fields: [pack_id], references: [id], onDelete: SetNull)

  @@unique([user_id, sticker_url])
  @@index([user_id, last_used_at(sort: Desc)])
  @@index([user_id, use_count(sort: Desc)])
}

/// Заявка на доступ к паку по приглашению. Одобрение добавляет пак в библиотеку пользователя.
model StickerAccessRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack_id    String    @db.Uuid
  user_id    String    @db.Uuid
  status     String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  created_at DateTime  @default(now()) @db.Timestamp(6)
  decided_at DateTime? @db.Timestamp(6)

  pack StickerPack @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([pack_id, user_id])
  @@index([status])
}

model StickerFavorite {
  user_id     String   @db.Uuid
  sticker_url String
  pack_id     String?  @db.Uuid
  added_at    DateTime @default(now()) @db.Timestamptz(6)

  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pack StickerPack? @relation(fields: [pack_id], references: [id], onDelete: SetNull)

  @@id([user_id, sticker_url])
  @@index([user_id, added_at(sort: Desc)])
}

// ── Activity Engine ──────────────────────────────────────────────────────────

/// Интерактив: Тайный Санта, Коллаб, Сломанный планшет и т.д.
model Activity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String    @db.VarChar(30) // collab | secret_santa | broken_tablet | other
  owner_id         String    @db.Uuid
  group_id         String?   @db.Uuid
  title            String    @db.VarChar(200)
  description      String?
  deadline         DateTime?
  max_participants Int?
  status           String    @default("active") @db.VarChar(20) // draft | active | completed | cancelled
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  owner        User                  @relation("ActivityOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  group        Group?                @relation(fields: [group_id], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]

  @@index([owner_id])
  @@index([group_id])
  @@index([status])
}

/// Участник интерактива с полным lifecycle-статусом
model ActivityParticipant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activity_id       String    @db.Uuid
  user_id           String    @db.Uuid
  // pending → approved → submitted → completed
  // pending → withdrawn (grace period <3d)
  // approved → delayed (organizer mark) → completed|fraud
  status            String    @default("pending") @db.VarChar(20)
  withdraw_deadline DateTime? // 3 days after joining; after this WITHDRAWN costs reputation
  submitted_at      DateTime?
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime? // soft delete

  activity Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([activity_id, user_id])
  @@index([user_id])
  @@index([activity_id, status])
}

/// Чёрный список: ручной (организатор/FRAUD) или авто (cron: 7д просрочка без DELAYED)
model ActivityBlacklist {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @unique @db.Uuid
  reason     String    @db.VarChar(500)
  banned_by  String?   @db.Uuid // NULL = авто-бан
  banned_at  DateTime  @default(now())
  expires_at DateTime?

  user   User  @relation("ActivityBlacklistUser", fields: [user_id], references: [id], onDelete: Cascade)
  banner User? @relation("ActivityBlacklistBanner", fields: [banned_by], references: [id], onDelete: SetNull)
}

model StickerBanner {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(120)
  subtitle    String?  @db.VarChar(240)
  tag_label   String?  @db.VarChar(60)
  image_url   String
  link_url    String?
  price_label String?  @db.VarChar(60)
  gradient    String?  @db.VarChar(120)
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([sort_order])
  @@index([is_active])
}

// ── Token rotation (15m access / 7d refresh) ─────────────────────────────────
model RefreshToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token_hash   String   @unique @db.VarChar(64) // SHA-256 of raw token
  expires_at   DateTime @db.Timestamptz(6)
  revoked      Boolean  @default(false)
  remember     Boolean  @default(false)
  device_name  String?  @db.VarChar(120)
  user_agent   String?
  ip_address   String?  @db.VarChar(64)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ── Fursona (1:N with User — up to 10 characters per user, enforced in service layer) ──
model Fursona {
  id                     String    @id @default(uuid()) @db.Uuid
  user_id                String    @db.Uuid
  name                   String    @default("") @db.VarChar(80)
  /// Hardcoded species list — stored as text array for multi-species characters
  species                String[]  @default([])
  /// Free-text species when "Other" is selected in `species`
  species_other          String?   @db.VarChar(50)
  /// Hex color palette, e.g. ["#FF5733", "#C70039"]
  colors                 String[]  @default([])
  likes_dislikes_visible Boolean   @default(true)
  likes                  String[]  @default([])
  dislikes               String[]  @default([])
  /// The character shown by default in compact UI (profile header, verification). Exactly one per user.
  is_primary             Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  user            User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  referenceImages FursonaReferenceImage[]

  @@index([user_id])
}

// ── Fursona reference gallery (1:N with Fursona) ─────────────────────────────
model FursonaReferenceImage {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  fursona_id  String    @db.Uuid
  image_url   String
  /// Mark this reference image as NSFW / 18+
  is_nsfw     Boolean   @default(false)
  artist_name String?   @db.VarChar(100)
  artist_url  String?   @db.VarChar(500)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  fursona Fursona @relation(fields: [fursona_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([fursona_id])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([image_url])
}

// ── Fursuit (1:N with User) ──────────────────────────────────────────────────
model Fursuit {
  id                   String    @id @default(uuid()) @db.Uuid
  user_id              String    @db.Uuid
  image_url            String?
  /// Optional link to a Bloomly Group (maker's studio) or User
  maker_id             String?   @db.Uuid
  /// Up to 3 external links for the maker (used when maker_id is absent)
  external_maker_links String[]  @default([])
  description          String?
  /// Mark fursuit reference/photo as NSFW / 18+
  is_nsfw              Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([image_url])
}

// ── Bloomly Shop ─────────────────────────────────────────────────────────────
model ShopItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String    @db.VarChar(20) // sticker_pack | theme | background | frame
  name            String    @db.VarChar(120)
  description     String?
  preview_url     String?
  price           Decimal   @default(0) @db.Decimal(10, 2)
  currency        String    @default("RUB") @db.VarChar(10)
  is_free         Boolean   @default(false)
  is_official     Boolean   @default(false)
  is_nsfw         Boolean   @default(false)
  tags            String[]  @default([])
  content_data    Json      @default("{}") // { css, url, pack_id, colors, etc. }
  downloads_count Int       @default(0)
  status          String    @default("published") @db.VarChar(20)
  ref_id          String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deleted_at      DateTime? @db.Timestamp(6)

  owners UserShopItem[]

  @@index([type])
  @@index([status])
  @@index([created_at(sort: Desc)])
