generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                    @id @default(uuid()) @db.Uuid
  email                          String                    @unique
  username                       String                    @unique
  password                       String?
  email_verified                 Boolean                   @default(false)
  onboarding_done                Boolean                   @default(false)
  display_name                   String?                   @db.VarChar(50)
  created_at                     DateTime                  @default(now())
  updated_at                     DateTime                  @updatedAt
  deleted_at                     DateTime?
  role                           String                    @default("user")
  bio                            String?                   @db.VarChar(300)
  avatar_url                     String?
  avatar_video_url               String?
  banner_url                     String?
  status                         String?                   @db.VarChar(100)
  persona                        String?
  likes                          String[]
  dislikes                       String[]
  accent_color                   String?
  website                        String?
  location                       String?
  pronouns                       String?
  badge_type                     String?
  prev_badge_type                String?
  job_title                      String?                   @db.VarChar(80)
  pinned_post_id                 String?                   @db.Uuid
  relationship_status            String?                   @db.VarChar(50)
  country                        String?                   @db.VarChar(80)
  fursona_name                   String?                   @db.VarChar(80)
  relationship_with              String?                   @db.Uuid
  birth_date                     DateTime?                 @db.Timestamp(6)
  birth_date_visibility          String                    @default("hidden") @db.VarChar(20)
  fursona_color                  String?                   @db.VarChar(50)
  fursona_gender                 String?                   @db.VarChar(50)
  fursona_description            String?
  relationship_since             DateTime?                 @db.Timestamp(6)
  fursona_photo_url              String?
  has_fursuit                    Boolean                   @default(false)
  fursuit_photo_url              String?
  fursuit_description            String?
  fursuit_maker                  String?                   @db.VarChar(200)
  social_links                   Json?                     @default("{}")
  interests                      String[]                  @default([])
  fav_food                       String?                   @db.VarChar(80)
  fav_animal                     String?                   @db.VarChar(80)
  fav_music                      String?                   @db.VarChar(80)
  fav_artist                     String?                   @db.VarChar(80)
  fav_film                       String?                   @db.VarChar(80)
  public_key                     String?
  subscription_tier              String                    @default("free") @db.VarChar(20)
  profile_theme                  String?                   @db.VarChar(50)
  profile_bg_url                 String?
  profile_frame                  String?                   @db.VarChar(50)
  artist_since                   DateTime?                 @db.Timestamp(6)
  verification_type              String?                   @db.VarChar(30)
  adRequests                     Advertisement[]           @relation("AdRequester")
  adReviews                      Advertisement[]           @relation("AdReviewer")
  comments                       Comment[]
  commentVotes                   CommentVote[]
  favourites                     Favourite[]
  postBookmarkLabels             PostBookmarkLabel[]
  followers                      Follow[]                  @relation("UserFollowers")
  following                      Follow[]                  @relation("UserFollowing")
  userBookmarksGiven             UserBookmark[]            @relation("UserBookmarkOwner")
  userBookmarksReceived          UserBookmark[]            @relation("UserBookmarkTarget")
  groupBookmarks                 GroupBookmark[]
  mediaHistory                   MediaHistory[]
  notifications                  Notification[]            @relation("NotificationReceiver")
  sentNotifications              Notification[]            @relation("NotificationSender")
  posts                          Post[]                    @relation("PostAuthor")
  rewardPosts                    Post[]                    @relation("PostRewardFor")
  sentRelationshipRequests       RelationshipRequest[]     @relation("SentRelationshipRequests")
  receivedRelationshipRequests   RelationshipRequest[]     @relation("ReceivedRelationshipRequests")
  repaws                         Repaw[]
  postViews                      PostView[]
  tagAffinities                  UserTagAffinity[]
  reports                        Report[]                  @relation("ReportReporter")
  resolvedReports                Report[]                  @relation("ReportResolver")
  stories                        Story[]
  storyViews                     StoryView[]
  storyVotes                     StoryVote[]
  pinnedPost                     Post?                     @relation("UserPinnedPost", fields: [pinned_post_id], references: [id])
  activities                     UserActivity[]
  votes                          Vote[]
  wallet                         Wallet?
  groupTransactions              GroupTransaction[]
  conversationParticipants       ConversationParticipant[]
  groupDmConversations           Conversation[]             @relation("GroupDmUser")
  sentMessages                   Message[]
  blocksGiven                    Block[]                   @relation("Blocker")
  blocksReceived                 Block[]                   @relation("Blocked")
  sentFriendRequests             Friendship[]              @relation("FriendshipRequester")
  receivedFriendRequests         Friendship[]              @relation("FriendshipAddressee")
  is_verified                    Boolean                   @default(false)
  verified_at                    DateTime?
  ownedGroups                    Group[]                   @relation("GroupOwner")
  groupMemberships               GroupMember[]
  groupSubscriptions             GroupSubscriber[]
  orders                         Order[]                   @relation("OrderCustomer")
  soonBadges                     SoonBadge[]
  verificationRequests           VerificationRequest[]
  groupRatings                   GroupRating[]
  dealerListings                 DealerListing[]
  dealerBids                     DealerBid[]
  dealerListingComments          DealerListingComment[]
  stickerPacks                   StickerPack[]
  stickerCollection              UserStickerPack[]
  stickerUsages                  StickerUsage[]
  stickerFavorites               StickerFavorite[]
  autoModLogs                    AutoModLog[]
  autoModActorLogs               AutoModLog[]              @relation("AutoModActor")
  adminBroadcasts                AdminBroadcast[]
  warn_count                     Int                       @default(0)
  frozen_at                      DateTime?
  frozen_reason                  String?                   @db.VarChar(500)
  deceased_at                    DateTime?
  deceased_note                  String?                   @db.VarChar(300)
  oauthAccounts                  OAuthAccount[]
  refreshTokens                  RefreshToken[]
  eventAttendances               EventAttendee[]           @relation("UserEventAttendees")
  groupMessages                  GroupMessage[]            @relation("UserGroupMessages")
  // Activity Engine
  ownedActivities                Activity[]                @relation("ActivityOwner")
  activityParticipations         ActivityParticipant[]
  activityBlacklist              ActivityBlacklist?        @relation("ActivityBlacklistUser")
  activityBlacklistsMade         ActivityBlacklist[]       @relation("ActivityBlacklistBanner")
  // Fursona & Fursuit
  fursonas                       Fursona[]
  fursuits                       Fursuit[]
  referenceImages                FursonaReferenceImage[]
  // Shop
  shopItems                      UserShopItem[]
  // Dealers Den v2
  den_frozen                     Boolean                   @default(false)
  denTrustScore                  DenTrustScore?
  denReviewsGiven                DenReview[]               @relation("DenReviewAuthor")
  denReviewsReceived             DenReview[]               @relation("DenReviewTarget")
  denWeeklyTops                  DenWeeklyTop[]
  denWishlist                    DenWishlist[]
  commissionBookings             CommissionBooking[]
  disputesBuyer                  DenDispute[]              @relation("DisputeBuyer")
  disputesSeller                 DenDispute[]              @relation("DisputeSeller")
  denFairParticipations          DenFairParticipant[]
  donate_url                     String?                   @db.VarChar(500)
  conversationKeys               ConversationKey[]
  // Privacy (all: "everyone" | "friends" | "nobody", except *_visibility below which use "only_me" instead of "nobody")
  messages_privacy               String                    @default("everyone") @db.VarChar(20)
  forward_identity_privacy       String                    @default("everyone") @db.VarChar(20)
  comments_privacy               String                    @default("everyone") @db.VarChar(20)
  mentions_privacy               String                    @default("everyone") @db.VarChar(20)
  online_status_visibility       String                    @default("everyone") @db.VarChar(20)
  friends_list_visibility        String                    @default("everyone") @db.VarChar(20)
  profile_visibility             String                    @default("everyone") @db.VarChar(20)
  relationship_status_visibility String                    @default("everyone") @db.VarChar(20)
  groups_visibility              String                    @default("everyone") @db.VarChar(20)
  groups_pinned_only             Boolean                   @default(false)
  last_seen_at                   DateTime?
  payment_region                 String?                   @db.VarChar(10)
  paymentMethods                 PaymentMethod[]
  supportTickets                 SupportTicket[]           @relation("SupportTicketUser")
  repliedSupportTickets          SupportTicket[]           @relation("SupportTicketReplier")
  two_factor_method              String?                   @db.VarChar(10)
  totp_secret                    String?
  // Automation settings (auto-follow-back, welcome DM, mute keywords, quiet hours, notify toggles, quick replies)
  auto_follow_back               Boolean                   @default(false)
  welcome_msg_enabled             Boolean                  @default(false)
  welcome_msg_text                String                   @default("Привет! Спасибо что подписался 🐾") @db.VarChar(300)
  mute_keywords                   String[]                 @default([])
  quiet_hours_enabled             Boolean                  @default(false)
  quiet_hours_from                String                   @default("23:00") @db.VarChar(5)
  quiet_hours_to                  String                   @default("08:00") @db.VarChar(5)
  notify_new_fan                  Boolean                  @default(true)
  notify_comment                  Boolean                  @default(true)
  notify_repaw                    Boolean                  @default(false)
  quick_replies                   String[]                 @default([])
  filter_spam                     Boolean                  @default(true)
}

model PaymentMethod {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  brand       String   @db.VarChar(20)
  last4       String   @db.VarChar(4)
  exp_month   Int
  exp_year    Int
  holder_name String   @db.VarChar(60)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model OAuthAccount {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  provider    String   @db.VarChar(50)
  provider_id String
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
}

model EmailOtp {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  code       String   @db.VarChar(10)
  purpose    String   @db.VarChar(30)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email, purpose])
}

model Post {
  id                  String         @id @default(uuid()) @db.Uuid
  content             String
  author_id           String         @db.Uuid
  rating              Int            @default(0)
  is_nsfw             Boolean        @default(false)
  is_announcement     Boolean        @default(false)
  subscriber_only     Boolean        @default(false)
  is_paid             Boolean        @default(false)
  price               Decimal?       @db.Decimal(10, 2)
  reward_for_user_id  String?        @db.Uuid
  video_title         String?        @db.VarChar(255)
  video_description   String?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  deleted_at          DateTime?
  category            String?
  title               String?        @db.VarChar(200)
  post_type           String         @default("general") @db.VarChar(30)
  media_urls          String[]       @default([])
  media_original_urls String[]       @default([])
  views_count         Int            @default(0)
  is_archived         Boolean        @default(false)
  comments_disabled   Boolean        @default(false)
  is_ai_generated     Boolean        @default(false)
  comments            Comment[]
  favourites          Favourite[]
  author              User           @relation("PostAuthor", fields: [author_id], references: [id])
  rewardForUser       User?          @relation("PostRewardFor", fields: [reward_for_user_id], references: [id])
  tags                PostTag[]
  repaws              Repaw[]
  pinnedBy            User[]         @relation("UserPinnedPost")
  groupPosts          GroupPost[]
  activities          UserActivity[]
  votes               Vote[]
  views               PostView[]

  @@index([author_id])
}

/// One row per (post, viewer) — the source of truth for Post.views_count, so a
/// person re-opening the same post in a new tab/session never inflates the count.
model PostView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

model Repaw {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  post_id     String   @db.Uuid
  /// Snapshot of the {term: delta} affinity deltas this repost applied to UserTagAffinity —
  /// lets toggleRepaw precisely undo it if the repost is retracted.
  term_deltas Json?
  created_at  DateTime @default(now())
  post        Post     @relation(fields: [post_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

model Favourite {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String             @db.Uuid
  post_id    String             @db.Uuid
  label_id   String?            @db.Uuid
  created_at DateTime           @default(now())
  post       Post               @relation(fields: [post_id], references: [id])
  user       User               @relation(fields: [user_id], references: [id])
  label      PostBookmarkLabel? @relation(fields: [label_id], references: [id], onDelete: SetNull)

  @@unique([user_id, post_id])
  @@index([label_id])
  @@index([post_id])
}

model PostBookmarkLabel {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @db.VarChar(60)
  color      String   @default("#4C67CF") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  favourites Favourite[]

  @@index([user_id])
}

model Tag {
  id    String    @id @default(uuid()) @db.Uuid
  name  String    @unique
  posts PostTag[]
}

model PostTag {
  post_id String @db.Uuid
  tag_id  String @db.Uuid
  post    Post   @relation(fields: [post_id], references: [id])
  tag     Tag    @relation(fields: [tag_id], references: [id])

  @@id([post_id, tag_id])
}

model Story {
  id         String      @id @default(uuid()) @db.Uuid
  user_id    String      @db.Uuid
  image_url  String?
  video_url  String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted_at DateTime?
  expires_at DateTime
  user       User        @relation(fields: [user_id], references: [id])
  views      StoryView[]
  votes      StoryVote[]

  @@index([user_id])
  @@index([created_at])
}

model StoryView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())
  story      Story    @relation(fields: [story_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([story_id, user_id])
  @@index([story_id])
}

model StoryVote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  story_id   String   @db.Uuid
  user_id    String   @db.Uuid
  value      Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  story      Story    @relation(fields: [story_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([story_id, user_id])
  @@index([story_id])
}

model Vote {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  post_id     String    @db.Uuid
  value       Int
  /// Snapshot of the {term: delta} affinity deltas this vote applied to UserTagAffinity —
  /// lets toggleVote precisely undo/re-derive on retract or flip without recomputing history.
  term_deltas Json?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  post        Post      @relation(fields: [post_id], references: [id])
  user        User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
  @@index([post_id])
}

/// Per-user, per-term (hashtag or content keyword) behavioral affinity for the feed algorithm.
/// `score` drives ranking (weighted, fed by likes/dislikes/reposts — see postService.applyTermDeltas);
/// `likes`/`dislikes` are plain counts kept for the settings "tag cloud" UI.
model UserTagAffinity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  term       String   @db.VarChar(60)
  source     String   @default("tag") @db.VarChar(20) // tag | keyword
  score      Float    @default(0)
  likes      Int      @default(0)
  dislikes   Int      @default(0)
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, term])
  @@index([user_id, score])
}

model Wallet {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @unique @db.Uuid
  balance    Decimal   @default(0.00) @db.Decimal(18, 2)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  user       User      @relation(fields: [user_id], references: [id])
}

model UserActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  type       String
  duration   Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  post       Post     @relation(fields: [post_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
}

model Comment {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String        @db.Uuid
  author_id  String        @db.Uuid
  /// Set when the real author (still author_id) posted this comment "as" a group they
  /// manage — the API masks author_id in the response and shows the group instead.
  group_id   String?       @db.Uuid
  parent_id  String?       @db.Uuid
  content    String
  type       String        @default("text")
  file_url   String?
  rating     Int           @default(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  deleted_at DateTime?
  author     User          @relation(fields: [author_id], references: [id])
  group      Group?        @relation(fields: [group_id], references: [id])
  parent     Comment?      @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[]     @relation("CommentReplies")
  post       Post          @relation(fields: [post_id], references: [id])
  votes      CommentVote[]

  @@index([post_id])
  @@index([parent_id])
  @@index([group_id])
}

model CommentVote {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  comment_id String    @db.Uuid
  value      Int
  created_at DateTime  @default(now())
  deleted_at DateTime?
  comment    Comment   @relation(fields: [comment_id], references: [id])
  user       User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, comment_id])
  @@index([comment_id])
}

model Follow {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  follower_id  String   @db.Uuid
  following_id String   @db.Uuid
  created_at   DateTime @default(now())
  notify_posts Boolean  @default(false)
  follower     User     @relation("UserFollowers", fields: [follower_id], references: [id])
  following    User     @relation("UserFollowing", fields: [following_id], references: [id])

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiver_id String    @db.Uuid
  sender_id   String?   @db.Uuid
  type        String
  post_id     String?   @db.Uuid
  comment_id  String?   @db.Uuid
  read        Boolean   @default(false)
  created_at  DateTime  @default(now())
  deleted_at  DateTime?
  ref_id      String?   @db.Uuid
  /// Small structured payload for system notifications (e.g. AutoMod warn count/reason) — not used by social notifications
  meta        Json?
  receiver    User      @relation("NotificationReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender      User?     @relation("NotificationSender", fields: [sender_id], references: [id])

  @@index([receiver_id])
  @@index([receiver_id, read], map: "Notification_receiver_read_idx")
  @@index([receiver_id, deleted_at])
}

model Advertisement {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  image_url    String?
  link_url     String
  contact_info String?
  price_label  String?   @db.VarChar(60)
  status       String    @default("pending")
  requester_id String?   @db.Uuid
  reviewed_by  String?   @db.Uuid
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  starts_at    DateTime?
  ends_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  deleted_at   DateTime?
  requester    User?     @relation("AdRequester", fields: [requester_id], references: [id])
  reviewer     User?     @relation("AdReviewer", fields: [reviewed_by], references: [id])
}

model MediaHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  url        String
  video_url  String?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String    @db.Uuid
  target_type String
  target_id   String    @db.Uuid
  reason      String
  status      String    @default("pending")
  resolved_by String?   @db.Uuid
  note        String?
  priority    Int       @default(0)
  ai_category String?   @db.VarChar(50)
  ai_score    Float     @default(0)
  evidence_urls String[] @default([])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  deleted_at  DateTime?
  reporter    User      @relation("ReportReporter", fields: [reporter_id], references: [id])
  resolver    User?     @relation("ReportResolver", fields: [resolved_by], references: [id])

  @@index([status])
  @@index([priority(sort: Desc), status])
}

model AutoModLog {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  actor_id           String?   @db.Uuid // staff member who performed a manual action; null for AutoMod-originated entries
  action             String    @db.VarChar(50)
  reason             String    @db.VarChar(300)
  category           String    @default("other") @db.VarChar(50)
  score              Float     @default(0)
  details            String?
  post_id            String?   @db.Uuid
  image_url          String?   // evidence photo attached by a moderator when resolving a report with a warning
  appeal_status      String    @default("none") @db.VarChar(20) // 'none' | 'pending' | 'accepted' | 'rejected'
  appeal_text        String?
  appeal_created_at  DateTime?
  appeal_resolved_at DateTime?
  appeal_resolved_by String?   @db.Uuid
  created_at         DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  actor              User?     @relation("AutoModActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([created_at])
  @@index([action])
  @@index([appeal_status])
}

model AdminBroadcast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id        String   @db.Uuid
  title           String   @db.VarChar(200)
  body            String   @db.VarChar(2000)
  audience        String   @db.VarChar(30) // all | premium | new | staff
  recipient_count Int      @default(0)
  created_at      DateTime @default(now())
  actor           User     @relation(fields: [actor_id], references: [id])

  @@index([created_at])
}

model SiteSetting {
  key        String   @id @db.VarChar(50)
  value      Boolean  @default(false)
  updated_at DateTime @default(now()) @updatedAt
}

model RelationshipRequest {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_id    String   @db.Uuid
  to_id      String   @db.Uuid
  status     String   @default("pending") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  from       User     @relation("SentRelationshipRequests", fields: [from_id], references: [id], onDelete: Cascade)
  to         User     @relation("ReceivedRelationshipRequests", fields: [to_id], references: [id], onDelete: Cascade)

  @@unique([from_id, to_id], map: "RelationshipRequest_from_to_unique")
  @@index([to_id, status])
}

// ── Messages ──────────────────────────────────────────────────────────────────

model Conversation {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @updatedAt
  deleted_at   DateTime?
  type         String                    @default("direct") @db.VarChar(20) // direct | group | community
  is_group     Boolean                   @default(false) // kept for back-compat; type='group' ⇒ is_group=true. type='community' is a 1:1-style thread and stays false.
  name         String?                   @db.VarChar(100)
  avatar_url   String?
  banner_url   String?
  group_id          String?  @db.Uuid // set when type='community'; many conversations share the same group_id (one per group_dm_user_id)
  group_dm_user_id  String?  @db.Uuid // set when type='community': the regular member's personal thread with the group; null on legacy shared group rooms
  participants ConversationParticipant[]
  messages     Message[]
  keys         ConversationKey[]
  group         Group? @relation("GroupCommunityChat", fields: [group_id], references: [id], onDelete: SetNull)
  group_dm_user User?  @relation("GroupDmUser", fields: [group_dm_user_id], references: [id], onDelete: Cascade)

  pinned_message_id String?  @db.Uuid
  pinnedMessage     Message? @relation("ConvPinnedMessage", fields: [pinned_message_id], references: [id], onDelete: SetNull)

  order Order? @relation("OrderConversation")

  @@unique([group_id, group_dm_user_id])
  @@index([group_id])
}

model ConversationKey {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  user_id         String       @db.Uuid
  encrypted_key   String // AES-256 conversation key encrypted with user's RSA-OAEP public key, base64
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id])
}

model Friendship {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_id String   @db.Uuid
  addressee_id String   @db.Uuid
  status       String   @default("pending") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(6)
  requester    User     @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee    User     @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, addressee_id])
  @@index([addressee_id, status])
  @@index([requester_id])
}

model Block {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @default(now())
  blocker    User     @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
}

model ConversationParticipant {
  conversation_id            String       @db.Uuid
  user_id                    String       @db.Uuid
  archived                   Boolean      @default(false)
  hidden_at                  DateTime?
  last_read_at               DateTime?
  role                       String       @default("member") @db.VarChar(20)
  label                      String       @default("default") @db.VarChar(20) // default | customer
  personal_pinned_message_id String?      @db.Uuid
  muted_until                DateTime?    // null = not muted; far-future = muted indefinitely
  sound_muted                Boolean      @default(false) // sound off, but toast/badge still shown
  conversation               Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user                       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@index([user_id, label])
}

model Message {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id          String         @db.Uuid
  sender_id                String         @db.Uuid
  text                     String?
  encrypted_text           String? // AES-GCM ciphertext: base64(iv[12] + ciphertext), null for plaintext messages
  type                     String         @default("text")
  file_url                 String?
  reply_to_id              String?        @db.Uuid
  reactions                Json?
  metadata                 Json? // structured payload for card-style messages (payment_request, payment_confirmation, tip)
  edited_at                DateTime?
  created_at               DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  deleted_at               DateTime?
  forwarded_from_id        String?        @db.Uuid // original message id
  forwarded_from_sender_id String?        @db.Uuid // original sender id
  forwarded_from_conv_id   String?        @db.Uuid // original conversation id
  conversation             Conversation   @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender                   User           @relation(fields: [sender_id], references: [id])
  reply_to                 Message?       @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies                  Message[]      @relation("MessageReplies")
  pinnedInConvs            Conversation[] @relation("ConvPinnedMessage")

  @@index([conversation_id, created_at(sort: Desc)])
  @@index([reply_to_id])
  @@index([sender_id, created_at])
}

// ── Groups ────────────────────────────────────────────────────────────────────

model Group {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String    @unique @db.VarChar(60)
  slug_aliases String[]  @default([]) // Old slugs kept for redirect
  name         String    @db.VarChar(120)
  description  String?
  type         String    @db.VarChar(20) // event | creative | static
  owner_id     String    @db.Uuid
  avatar_url   String?
  banner_url   String?
  accent_color String?   @db.VarChar(20)
  social_links Json?     @default("{}")
  is_public    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  // Extended fields
  rules_text    String? // Правила группы (markdown)
  faq           Json?   @default("[]") // [{q: "...", a: "..."}]
  contact_phone String? @db.VarChar(30)
  contact_email String? @db.VarChar(120)
  about_text    String? // Расширенное описание
  schedule      Json?   @default("[]") // [{time: "09:30-10:00", label: "..."}]
  what_to_bring Json?   @default("[]") // ["Коврик", "Вода"]
  is_nsfw       Boolean @default(false)
  rating        Float   @default(0)
  rating_count  Int     @default(0)
  members_count Int     @default(0)

  // Creative-specific
  production_time String? @db.VarChar(100) // "2-3 месяца"
  delivery_info   String? @db.VarChar(200) // "Доставка по всему миру"
  completed_works Int     @default(0)
  guarantee_text  String? @db.VarChar(300)

  // Event-specific
  sponsors Json @default("[]") // [{name, logo_url, url, tier?}]

  // Business customization
  group_bg_url      String?
  group_frame       String? @db.VarChar(100)
  group_theme       String? @db.VarChar(100)
  hide_admins       Boolean @default(false)
  hidden_member_ids String  @default("[]")

  // Donations & support tiers
  donations_enabled Boolean @default(false)
  bank_card_masked  String? @db.VarChar(25) // e.g. "**** **** **** 4242"
  support_tiers     Json    @default("[]") // [{emoji,name,price,desc}]

  // Moderation / discovery
  is_verified         Boolean   @default(false) // Official / verified community
  category            String?   @db.VarChar(50) // art | cosplay | fandom | dev | music | etc.
  category_changed_at DateTime? // last time category was changed — gates 1x/month cooldown

  // Event lifecycle (type == "event" only) — admin-set date; once past, SOON badges are cleared
  // and plain members are demoted to notification-only subscribers until a new date is set.
  event_date       DateTime? // NULL = feature inactive for this group
  event_expired_at DateTime? // set once the expiry sweep has run for the current event_date

  // Business tab (orders/kanban) — owner-toggleable, independent of `type`
  business_enabled Boolean @default(false)

  // Custom Todolist kanban columns — [{key,label,color,icon}]; empty/null = use default 5-stage set
  todo_columns Json? @default("[]")

  // Group balance — credited by member donations (Wallet-funded), spent by the owner outside the app for now
  balance Decimal @default(0.00) @db.Decimal(18, 2)

  owner          User               @relation("GroupOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members        GroupMember[]
  events         Event[]
  commissionInfo CommissionInfo?
  posts          GroupPost[]
  comments       Comment[]
  ratings        GroupRating[]
  groupMessages  GroupMessage[]
  groupDmThreads Conversation[]     @relation("GroupCommunityChat")
  activities     Activity[]
  todoItems      GroupTodoItem[]
  customRoles    GroupCustomRole[]
  bookmarks      GroupBookmark[]
  subscribers    GroupSubscriber[]
  orders         Order[]
  transactions   GroupTransaction[]

  @@index([owner_id])
  @@index([type])
}

// ── Group balance ledger — funded by member donations from their personal Wallet ──
model GroupTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String?  @db.Uuid // donor; null for system adjustments
  type       String   @db.VarChar(20) // DONATION | ADJUSTMENT
  amount     Decimal  @db.Decimal(18, 2)
  message    String?  @db.VarChar(280)
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([group_id, created_at])
}

model GroupRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  value      Int // -1 (downvote) or 1 (upvote) — Reddit-style
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id])
}

enum TodoStatus {
  WAITING
  SKETCH
  LINEART
  COLORING
  FINISHED
}

model GroupTodoItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String     @db.Uuid
  title       String     @db.VarChar(200)
  description String?
  status      String     @default("WAITING") @db.VarChar(30) // key of a Group.todo_columns entry (or default stage)
  position    Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([group_id, deleted_at])
}

// ── Group Business tab: Orders ──────────────────────────────────────────────
model Order {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id        String     @db.Uuid
  customer_id     String     @db.Uuid
  title           String     @db.VarChar(200)
  description     String?
  form_data       Json?
  status          TodoStatus @default(WAITING)
  position        Int        @default(0)
  deadline_at     DateTime?
  conversation_id String?    @unique @db.Uuid
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  group        Group         @relation(fields: [group_id], references: [id], onDelete: Cascade)
  customer     User          @relation("OrderCustomer", fields: [customer_id], references: [id], onDelete: Cascade)
  conversation Conversation? @relation("OrderConversation", fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([group_id, deleted_at])
  @@index([customer_id])
  @@index([deadline_at])
}

model GroupCustomRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String   @db.Uuid
  name        String   @db.VarChar(50)
  color       String   @default("#9ca3af") @db.VarChar(20)
  icon        String   @default("🎖️") @db.VarChar(20)
  permissions Json     @default("[]")
  position    Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@index([group_id])
}

model GroupMember {
  group_id     String   @db.Uuid
  user_id      String   @db.Uuid
  role         String   @default("member") @db.VarChar(20) // owner | admin | moderator | member | dealer | volunteer | guest_of_honor
  joined_at    DateTime @default(now())
  is_pinned    Boolean  @default(false)
  notify_posts Boolean  @default(true)

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([group_id, user_id])
  @@index([user_id])
}

// Notification-only follower — created when a participant is demoted after their group's
// event_date lapses, or chosen directly by a user who wants updates without joining.
model GroupSubscriber {
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([group_id, user_id])
  @@index([user_id])
}

model GroupPost {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  post_id    String   @db.Uuid
  pinned     Boolean  @default(false)
  created_at DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([group_id, post_id])
}

// ── Events (афиша) ────────────────────────────────────────────────────────────

model Event {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id       String   @db.Uuid
  title          String   @db.VarChar(200)
  short_code     String   @db.VarChar(10) // FURM, EF, etc.
  description    String?
  banner_url     String?
  location_name  String?  @db.VarChar(200)
  location_lat   Float?
  location_lng   Float?
  starts_at      DateTime
  ends_at        DateTime
  status         String   @default("announced") @db.VarChar(30)
  is_recurring   Boolean  @default(false)
  theme          Json?    @default("{}")
  attendee_count Int      @default(0)
  is_top         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Extended fields
  schedule         Json?   @default("[]") // [{time, label}]
  what_to_bring    Json?   @default("[]") // string[]
  rules_text       String?
  faq              Json?   @default("[]") // [{q, a}]
  registration_url String? @db.VarChar(500) // External registration link

  group      Group           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  tickets    TicketTier[]
  soonBadges SoonBadge[]
  attendees  EventAttendee[]
  subEvents  SubEvent[]

  @@index([group_id])
  @@index([starts_at])
  @@index([status])
}

// ── Sub-events (panels, workshops within a main Event) ────────────────────────

model SubEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String    @db.Uuid
  title         String    @db.VarChar(200)
  type          String    @default("panel") @db.VarChar(50) // panel | workshop | performance | other
  speaker       String?   @db.VarChar(200)
  location_name String?   @db.VarChar(200)
  starts_at     DateTime
  ends_at       DateTime?
  description   String?
  created_at    DateTime  @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([starts_at])
}

model TicketTier {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String    @db.Uuid
  name           String    @db.VarChar(100)
  price          Decimal   @db.Decimal(10, 2)
  currency       String    @default("USD") @db.VarChar(10)
  total_count    Int
  sold_count     Int       @default(0)
  sale_starts_at DateTime?
  sale_ends_at   DateTime?
  description    String? // Short description of what's included
  perks          String[]  @default([]) // ["Одноместный", "Разовое питание"]
  created_at     DateTime  @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
}

// ── SOON Badge ────────────────────────────────────────────────────────────────

model SoonBadge {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  event_id   String   @db.Uuid
  show_badge Boolean  @default(true)
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_id])
  @@index([user_id])
  @@index([event_id])
}

// ── Event RSVP (Attendees) ───────────────────────────────────────────

model EventAttendee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String   @db.Uuid
  user_id      String   @db.Uuid
  status       String   @default("going") @db.VarChar(20) // going | maybe | not_going
  confirmed_at DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation("UserEventAttendees", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

// ── Commission Info (для Creative-групп) ──────────────────────────────────────

model CommissionInfo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id    String   @unique @db.Uuid
  status      String   @default("closed") @db.VarChar(20) // open | closed | waitlist
  base_prices Json?    @default("{}")
  currency    String   @default("USD") @db.VarChar(10)
  tos_text    String?
  max_queue   Int      @default(5)
  updated_at  DateTime @updatedAt

  // Extended
  rush_slots      Int     @default(0) // быстрые заказы - свободные слоты
  rush_max        Int     @default(0)
  turnaround_days String? @db.VarChar(30) // "5-7 дней"
  price_list      Json?   @default("[]") // [{name, price, description}]

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
}

// ── Group Messages (realtime group chat) ───────────────────────────────────

model GroupMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String    @db.Uuid
  user_id    String    @db.Uuid
  text       String
  created_at DateTime  @default(now())
  deleted_at DateTime?

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation("UserGroupMessages", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at(sort: Desc)])
  @@index([user_id])
}

// ── Verification Requests ─────────────────────────────────────────────────────

model VerificationRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  status            String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  reason            String?   @db.VarChar(500) // rejection reason or notes
  // Criteria snapshot at request time
  account_age_days  Int       @default(0)
  post_count        Int       @default(0)
  has_avatar        Boolean   @default(false)
  has_bio           Boolean   @default(false)
  has_email         Boolean   @default(false)
  follower_count    Int       @default(0)
  // Timestamps
  created_at        DateTime  @default(now())
  reviewed_at       DateTime?
  reviewed_by       String?   @db.Uuid
  verification_type String?   @db.VarChar(30) // artist, master, fursuiter, popular, writer, organizer, event, photographer, programmer
  evidence_urls     String[]  @default([])
  evidence_text     String?   @db.VarChar(2000) // optional written explanation, alongside or instead of uploaded evidence
  badge_type        String?   @db.VarChar(30) // verified, artist, master, event

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

// ── Dealers Den ───────────────────────────────────────────────────────────────

model DealerListing {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id              String    @db.Uuid
  title                  String    @db.VarChar(200)
  description            String?
  price                  Decimal   @default(0) @db.Decimal(12, 2)
  currency               String    @default("USD") @db.VarChar(10)
  category               String    @default("other") @db.VarChar(50) // art | fursuit | badge | print | music | craft | merch | other
  type                   String    @default("physical") @db.VarChar(20) // digital | physical | both
  listing_kind           String    @default("fixed") @db.VarChar(20) // fixed | auction | ych | raffle | commission_queue
  images                 String[]  @default([])
  status                 String    @default("active") @db.VarChar(20) // active | sold | draft | archived
  quantity               Int       @default(1)
  quantity_sold          Int       @default(0)
  is_nsfw                Boolean   @default(false)
  tags                   String[]  @default([])
  // ── Auction / YCH / Raffle fields ──────────────────────────────────────────
  auction_ends_at        DateTime? @db.Timestamp(6)
  current_bid            Decimal?  @db.Decimal(12, 2)
  bid_count              Int       @default(0)
  bid_increment          Decimal   @default(1) @db.Decimal(12, 2)
  auto_buy_price         Decimal?  @db.Decimal(12, 2)
  raffle_max_tickets     Int?
  raffle_tickets_sold    Int       @default(0)
  winner_id              String?   @db.Uuid
  // ── Commission Queue fields ─────────────────────────────────────────────────
  commission_slots_total Int?
  commission_slots_taken Int       @default(0)
  commission_eta_days    Int?
  commission_form_fields Json?     @default("[]")
  // ────────────────────────────────────────────────────────────────────────────
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deleted_at             DateTime? @db.Timestamp(6)

  seller           User                   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  bids             DealerBid[]
  comments         DealerListingComment[]
  reviews          DenReview[]
  wishlistItems    DenWishlist[]
  bookings         CommissionBooking[]
  disputes         DenDispute[]
  fairParticipants DenFairParticipant[]

  @@index([seller_id])
  @@index([status])
  @@index([category])
  @@index([listing_kind])
  @@index([auction_ends_at])
  @@index([created_at(sort: Desc)])
}

model DenTrustScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
