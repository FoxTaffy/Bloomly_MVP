model UserShopItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  item_id      String   @db.Uuid
  purchased_at DateTime @default(now()) @db.Timestamp(6)

  user User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([user_id, item_id])
  @@index([user_id])
}

model BloomlyUpdate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  body       String?
  image_url  String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_at(sort: Desc)])
}

// ── User & Group Bookmarks ────────────────────────────────────────────────────

model UserBookmark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  target_id  String   @db.Uuid
  created_at DateTime @default(now())

  user   User @relation("UserBookmarkOwner", fields: [user_id], references: [id], onDelete: Cascade)
  target User @relation("UserBookmarkTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_id])
  @@index([user_id])
  @@index([target_id])
}

model GroupBookmark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  group_id   String   @db.Uuid
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, group_id])
  @@index([user_id])
  @@index([group_id])
}

// ── Help Center: support tickets (bug reports / feedback / questions) ────────

model SupportTicket {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?  @db.Uuid
  type             String   @default("question") @db.VarChar(20) // bug, feedback, question, other
  subject          String   @db.VarChar(150)
  contact_email    String?  @db.VarChar(255)
  status           String   @default("open") @db.VarChar(20) // open, in_progress, resolved, closed
  // 'app' = created from the in-app Help form; 'email' = created from an inbound message to the support mailbox.
  source           String   @default("app") @db.VarChar(10)
  // Raw sender address for email-origin tickets (used as the reply-to target); distinct from contact_email.
  external_email   String?  @db.VarChar(255)
  // Message-ID of the most recent inbound email in this thread, for In-Reply-To/References on outgoing replies.
  email_message_id String?  @db.VarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  user     User?                  @relation("SupportTicketUser", fields: [user_id], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([user_id])
  @@index([status])
}

model SupportTicketMessage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String   @db.Uuid
  sender_type      String   @db.VarChar(10) // 'user' | 'admin' | 'external'
  sender_user_id   String?  @db.Uuid
  body             String   @db.Text
  // Message-ID of this specific message when it came from (or was sent as) an email, for threading.
  email_message_id String?  @db.VarChar(255)
  attachment_urls  String[] @default([])
  created_at       DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender User?         @relation("SupportTicketMessageSender", fields: [sender_user_id], references: [id])

  @@index([ticket_id])
}

/// Пользовательский альбом медиа: принадлежит либо профилю (user_id), либо группе (group_id).
model Album {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  group_id    String?  @db.Uuid
  title       String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  // public | friends (профиль: взаимные подписки; группа: участники) | private (только владелец / модерация)
  privacy     String   @default("public") @db.VarChar(10)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  user  User?       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group Group?      @relation(fields: [group_id], references: [id], onDelete: Cascade)
  items AlbumItem[]

  @@index([user_id])
  @@index([group_id])
}

model AlbumItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  album_id   String   @db.Uuid
  media_url  String   @db.VarChar(1024)
  position   Int
  created_at DateTime @default(now())

  album Album @relation(fields: [album_id], references: [id], onDelete: Cascade)

  @@index([album_id, position])

  // Проверка доступа к файлу по прямой ссылке (media/access.ts)
  @@index([media_url])
}

/// Журнал действий пользователей (заявки в друзья, подписки): по нему разбирают жалобы «нажал, а не сработало».
model UserActionLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  action     String   @db.VarChar(50)
  target_id  String?  @db.Uuid
  ok         Boolean  @default(true)
  error      String?  @db.VarChar(300)
  before     Json?
  after      Json?
  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@index([target_id, created_at])
  @@index([action, created_at])
}

/// Подписка браузера на Web Push (системные уведомления вне вкладки)
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?  @db.VarChar(300)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// Рекламные ссылки (админка → «Трафик»). Короткая ссылка /api/t/:code пишет клик на сервере
/// и ведёт на target_path с UTM-метками, поэтому клик не теряется, даже если метки срежет посредник.
model TrackingLink {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(120)
  target_path  String   @db.VarChar(300)
  utm_source   String   @db.VarChar(60)
  utm_medium   String   @db.VarChar(60)
  utm_campaign String   @db.VarChar(100)
  utm_content  String?  @db.VarChar(100)
  utm_term     String?  @db.VarChar(100)
  is_active    Boolean  @default(true)
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  clicks TrackingClick[]
  visits TrackingVisit[]

  @@index([created_at])
}

/// Переход по короткой ссылке. Боты (превью мессенджеров, краулеры) и повторы с того же устройства
/// помечаются и в «уникальные» не попадают.
model TrackingClick {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  link_id      String       @db.Uuid
  link         TrackingLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  ip_hash      String       @db.VarChar(64)
  user_agent   String?      @db.VarChar(200)
  referrer     String?      @db.VarChar(300)
  is_bot       Boolean      @default(false)
  is_duplicate Boolean      @default(false)
  created_at   DateTime     @default(now())

  @@index([link_id, created_at])
  @@index([link_id, ip_hash, created_at])
}

/// Открытие сайта с меткой (JS на лендинге). Сравнение с кликами показывает, сколько трафика потерялось по дороге.
model TrackingVisit {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  link_id      String?       @db.Uuid
  link         TrackingLink? @relation(fields: [link_id], references: [id], onDelete: Cascade)
  click_id     String?       @db.Uuid
  visitor_id   String        @db.VarChar(64)
  utm_source   String?       @db.VarChar(60)
  utm_medium   String?       @db.VarChar(60)
  utm_campaign String?       @db.VarChar(100)
  utm_content  String?       @db.VarChar(100)
  landing_path String?       @db.VarChar(300)
  created_at   DateTime      @default(now())

  @@index([link_id, created_at])
  @@index([visitor_id, created_at])
  @@index([utm_campaign, created_at])
}

/// Откуда пришёл зарегистрировавшийся. Первое касание и последнее хранятся раздельно: если человек
/// успел побывать на двух рекламах, регистрация не достаётся «победителю» случайно, а конфликт виден в отчёте.
model UserAttribution {
  user_id       String    @id @db.Uuid
  visitor_id    String    @db.VarChar(64)
  first_link_id String?   @db.Uuid
  last_link_id  String?   @db.Uuid
  first_utm     Json?
  last_utm      Json?
  first_seen_at DateTime?
  created_at    DateTime  @default(now())

  @@index([first_link_id])
  @@index([last_link_id])
  @@index([created_at])
}
